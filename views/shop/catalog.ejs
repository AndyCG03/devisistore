<%- include('../partials/head') %>

<!-- Navbar simplificado para página pública -->
<nav class="bg-white border-b border-gray-100 shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-bold text-brand-700 text-lg">CatalogHub</a>
    <% if (locals.user) { %>
      <a href="/dashboard" class="text-sm text-gray-500 hover:text-brand-600 font-medium">Mi Panel</a>
    <% } else { %>
      <a href="/auth/login" class="text-sm text-gray-500 hover:text-brand-600 font-medium">Iniciar sesión</a>
    <% } %>
  </div>
</nav>

<!-- HEADER DEL NEGOCIO -->
<header class="gradient-hero text-white py-12 px-4">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center gap-6">
    <% if (business.logo) { %>
      <img src="<%= business.logo %>" alt="<%= business.name %>"
           class="w-24 h-24 rounded-2xl object-cover border-4 border-white/30 shadow-lg flex-shrink-0" />
    <% } else { %>
      <div class="w-24 h-24 rounded-2xl bg-white/20 flex items-center justify-center text-5xl flex-shrink-0">🏪</div>
    <% } %>
    <div class="text-center sm:text-left">
      <h1 class="text-3xl font-extrabold mb-1"><%= business.name %></h1>
      <% if (business.description) { %>
        <p class="text-blue-100 text-sm max-w-xl"><%= business.description %></p>
      <% } %>
      <div class="flex flex-wrap items-center gap-3 mt-3 justify-center sm:justify-start">
        <% if (business.phone) { %>
          <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full">📞 <%= business.phone %></span>
        <% } %>
        <% if (business.schedule) { %>
          <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full">🕐 <%= business.schedule %></span>
        <% } %>
        <% if (business.address) { %>
          <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full">📍 <%= business.address %></span>
        <% } %>
      </div>
    </div>

    <!-- Botón WhatsApp -->
    <% if (business.whatsapp) { %>
      <div class="sm:ml-auto">
        <a href="https://wa.me/<%= business.whatsapp.replace(/\D/g,'') %>?text=<%= encodeURIComponent('¡Hola! Me interesa un producto de tu catálogo.') %>"
           target="_blank"
           class="flex items-center gap-2 bg-green-500 hover:bg-green-400 text-white font-bold px-5 py-3 rounded-xl shadow-lg transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.534 5.858L0 24l6.335-1.524A11.935 11.935 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.799 9.799 0 01-5.012-1.375l-.36-.214-3.732.897.934-3.63-.236-.374A9.755 9.755 0 012.182 12c0-5.413 4.405-9.818 9.818-9.818 5.413 0 9.818 4.405 9.818 9.818 0 5.413-4.405 9.818-9.818 9.818z"/>
          </svg>
          WhatsApp
        </a>
      </div>
    <% } %>
  </div>
</header>

<!-- CATÁLOGO -->
<section class="py-10 px-4 max-w-6xl mx-auto">

  <!-- Filtros -->
  <form method="GET" class="flex flex-wrap gap-3 mb-8">
    <input type="text" name="search" value="<%= search %>"
           placeholder="Buscar productos..."
           class="flex-1 min-w-[180px] px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none bg-white shadow-sm" />

    <select name="category"
            class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none bg-white shadow-sm">
      <option value="all" <%= category === 'all' ? 'selected' : '' %>>Todas las categorías</option>
      <% categories.forEach(c => { %>
        <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>

    <button type="submit" class="bg-brand-600 text-white px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-brand-700 transition shadow">
      Buscar
    </button>
    <a href="/shop/<%= business.slug %>" class="bg-gray-100 text-gray-600 px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-gray-200 transition">
      Ver todo
    </a>
  </form>

  <!-- Grid de productos -->
  <% if (products.length === 0) { %>
    <div class="text-center py-20">
      <div class="text-5xl mb-4">🔍</div>
      <p class="text-gray-500 font-medium">No se encontraron productos.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-5">
      <% products.forEach(p => { %>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm card-hover overflow-hidden
                  <%= p.status === 'unavailable' ? 'opacity-70' : '' %>">
        <div class="aspect-square overflow-hidden bg-gray-50">
          <% if (p.image) { %>
            <img src="<%= p.image %>" alt="<%= p.name %>"
                 class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center text-5xl text-gray-300">📷</div>
          <% } %>
        </div>

        <div class="p-4">
          <% if (p.category) { %>
            <span class="text-xs text-brand-600 bg-brand-50 px-2 py-0.5 rounded-full"><%= p.category %></span>
          <% } %>
          <h3 class="font-semibold text-gray-900 mt-1 text-sm leading-snug"><%= p.name %></h3>
          <% if (p.description) { %>
            <p class="text-xs text-gray-400 mt-0.5 leading-snug">
              <%= p.description.length > 60 ? p.description.slice(0,60) + '...' : p.description %>
            </p>
          <% } %>

          <div class="flex items-center justify-between mt-3">
            <span class="text-base font-bold text-gray-900">$<%= parseFloat(p.price).toFixed(2) %></span>
            <% if (p.status === 'unavailable') { %>
              <span class="text-xs text-red-500 font-medium">Agotado</span>
            <% } else if (business.whatsapp) { %>
              <a href="https://wa.me/<%= business.whatsapp.replace(/\D/g,'') %>?text=<%= encodeURIComponent(`Hola! Me interesa el producto: ${p.name} ($${parseFloat(p.price).toFixed(2)})`) %>"
                 target="_blank"
                 class="bg-green-500 hover:bg-green-400 text-white text-xs px-3 py-1.5 rounded-lg transition font-medium">
                Pedir
              </a>
            <% } %>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Paginación -->
    <% if (pages > 1) { %>
    <div class="flex justify-center items-center gap-2 mt-10">
      <% for (let i = 1; i <= pages; i++) { %>
        <a href="?page=<%= i %>&category=<%= category %>&search=<%= search %>"
           class="w-9 h-9 flex items-center justify-center rounded-xl text-sm font-medium transition
                  <%= i === currentPage ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-600 hover:border-brand-400' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
    <% } %>
  <% } %>

  <!-- Redes sociales -->
  <% const hasSocials = Object.values(socials).some(v => v && v.trim()); %>
  <% if (hasSocials) { %>
  <div class="mt-12 text-center">
    <p class="text-sm text-gray-500 mb-3">Síguenos en redes sociales</p>
    <div class="flex justify-center gap-4">
      <% if (socials.instagram) { %>
        <a href="https://instagram.com/<%= socials.instagram.replace('@','') %>" target="_blank"
           class="text-pink-500 hover:text-pink-600 font-medium text-sm">📸 Instagram</a>
      <% } %>
      <% if (socials.facebook) { %>
        <a href="https://facebook.com/<%= socials.facebook.replace('@','') %>" target="_blank"
           class="text-blue-600 hover:text-blue-700 font-medium text-sm">👍 Facebook</a>
      <% } %>
      <% if (socials.tiktok) { %>
        <a href="https://tiktok.com/@<%= socials.tiktok.replace('@','') %>" target="_blank"
           class="text-gray-900 hover:text-gray-600 font-medium text-sm">🎵 TikTok</a>
      <% } %>
    </div>
  </div>
  <% } %>
</section>

<!-- Footer del catálogo -->
<footer class="border-t border-gray-100 py-6 text-center text-xs text-gray-400 mt-10">
  Catálogo creado con <a href="/" class="text-brand-600 hover:underline">CatalogHub</a>
</footer>

</body>
</html>
