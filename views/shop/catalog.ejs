<%- include('../partials/head') %>

<!-- Shop navbar -->
<nav style="background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:50;box-shadow:0 1px 4px rgba(46,95,168,.06)">
  <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:3.75rem">
    <a href="/" style="text-decoration:none;display:flex;align-items:center">
      <img src="/assets/logo.png" alt="Devisi Store" style="height:1.75rem;width:auto;object-fit:contain"
           onerror="this.style.display='none';this.nextElementSibling.style.display='inline'" />
      <span style="display:none;font-weight:800;font-size:.95rem"><span style="color:var(--blue)">Devisi</span><span style="color:var(--green)">Store</span></span>
    </a>
    
    <!-- Mobile menu button -->
    <button id="mobileMenuBtn" style="display:none;background:none;border:none;cursor:pointer;padding:.5rem;border-radius:8px;transition:var(--tr)">
      <svg id="menuIcon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dark)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="closeIcon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dark)" stroke-width="2" style="display:none"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    
    <!-- Desktop nav -->
    <div id="desktopNav" style="display:flex;align-items:center;gap:.5rem">
      <% if(locals.user){ %>
        <a href="/dashboard" style="font-size:.875rem;font-weight:600;color:var(--gray);text-decoration:none;padding:.4rem .875rem;border-radius:8px;transition:var(--tr)" onmouseover="this.style.color='var(--blue)';this.style.background='var(--blue-light)'" onmouseout="this.style.color='var(--gray)';this.style.background='transparent'">Mi Panel</a>
      <% } else { %>
        <a href="/auth/login" style="font-size:.875rem;font-weight:600;color:var(--gray);text-decoration:none;padding:.4rem .875rem;border-radius:8px;transition:var(--tr)" onmouseover="this.style.color='var(--blue)'" onmouseout="this.style.color='var(--gray)'">Iniciar sesión</a>
      <% } %>
    </div>
  </div>
  
  <!-- Mobile nav menu -->
  <div id="mobileMenu" style="display:none;background:var(--white);border-top:1px solid var(--border);padding:1rem 1.5rem;position:absolute;top:3.75rem;left:0;right:0;box-shadow:0 4px 12px rgba(0,0,0,.1);z-index:40">
    <div style="display:flex;flex-direction:column;gap:.75rem">
      <% if(locals.user){ %>
        <a href="/dashboard" style="display:flex;align-items:center;gap:.75rem;font-size:.9375rem;font-weight:600;color:var(--dark);text-decoration:none;padding:.625rem .875rem;border-radius:8px;transition:var(--tr);background:var(--bg)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Mi Panel
        </a>
      <% } else { %>
        <a href="/auth/login" style="display:flex;align-items:center;gap:.75rem;font-size:.9375rem;font-weight:600;color:var(--dark);text-decoration:none;padding:.625rem .875rem;border-radius:8px;transition:var(--tr)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v7"/></svg>
          Iniciar sesión
        </a>
        <a href="/auth/register" style="display:flex;align-items:center;justify-content:center;gap:.5rem;font-size:.9375rem;font-weight:700;color:#fff;text-decoration:none;padding:.75rem 1rem;border-radius:10px;background:var(--blue);box-shadow:0 2px 8px rgba(46,95,168,.24);transition:var(--tr)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Registrarse
        </a>
      <% } %>
    </div>
  </div>
</nav>

<script>
// Mobile menu toggle para shop
document.addEventListener('DOMContentLoaded', function() {
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const menuIcon = document.getElementById('menuIcon');
  const closeIcon = document.getElementById('closeIcon');
  const desktopNav = document.getElementById('desktopNav');

  function isMobile() {
    return window.innerWidth <= 768;
  }

  function toggleMenu() {
    const isOpen = mobileMenu.style.display === 'block';
    mobileMenu.style.display = isOpen ? 'none' : 'block';
    menuIcon.style.display = isOpen ? 'block' : 'none';
    closeIcon.style.display = isOpen ? 'none' : 'block';
    if (!isOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  }

  function closeMenu() {
    mobileMenu.style.display = 'none';
    menuIcon.style.display = 'block';
    closeIcon.style.display = 'none';
    document.body.style.overflow = '';
  }

  function updateMenuDisplay() {
    if (isMobile()) {
      mobileMenuBtn.style.display = 'block';
      desktopNav.style.display = 'none';
    } else {
      mobileMenuBtn.style.display = 'none';
      desktopNav.style.display = 'flex';
      closeMenu();
    }
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', toggleMenu);
  }

  if (mobileMenu) {
    mobileMenu.querySelectorAll('a').forEach(function(el) {
      el.addEventListener('click', closeMenu);
    });
  }

  document.addEventListener('click', function(e) {
    if (isMobile() && mobileMenu.style.display === 'block' && 
        !mobileMenu.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
      closeMenu();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && isMobile() && mobileMenu.style.display === 'block') {
      closeMenu();
    }
  });

  updateMenuDisplay();
  window.addEventListener('resize', updateMenuDisplay);
  
  // Efecto hover en botón móvil
  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('mouseenter', function() {
      this.style.background = 'var(--bg)';
    });
    mobileMenuBtn.addEventListener('mouseleave', function() {
      this.style.background = 'none';
    });
  }
});
</script>

<!-- Business header -->
<%
  // Función para oscurecer color hexadecimal (se ejecuta en servidor)
  function darkenColor(hex, percent) {
    try {
      hex = String(hex).replace(/^\s*#|\s*$/g, '');
      if (hex.length === 3) {
        hex = hex.replace(/(.)/g, '$1$1');
      }
      const r = parseInt(hex.substr(0, 2), 16);
      const g = parseInt(hex.substr(2, 2), 16);
      const b = parseInt(hex.substr(4, 2), 16);
      const darkR = Math.max(0, r - (r * percent / 100));
      const darkG = Math.max(0, g - (g * percent / 100));
      const darkB = Math.max(0, b - (b * percent / 100));
      return '#' + ((1 << 24) + (Math.round(darkR) << 16) + (Math.round(darkG) << 8) + Math.round(darkB)).toString(16).slice(1);
    } catch(e) {
      return '#1E4585';
    }
  }
  
  const headerColor = business && business.header_color ? business.header_color : '#2E5FA8';
  const headerColorDark = darkenColor(headerColor, 20);
%>

<header class="hero-gradient" style="padding:3rem 1.5rem;background:linear-gradient(135deg,<%=headerColor%> 0%,<%=headerColor%> 50%,<%=headerColorDark%> 100%)">
  <div style="max-width:1100px;margin:0 auto">

    <!-- Logo centrado -->
    <div style="text-align:center;margin-bottom:2rem">
      <% if(business.logo){ %>
        <img src="<%=business.logo%>" alt="<%=business.name%>" style="width:6rem;height:6rem;border-radius:16px;object-fit:cover;border:3px solid rgba(255,255,255,.25);box-shadow:0 4px 16px rgba(0,0,0,.2)" />
      <% } else { %>
        <div style="width:6rem;height:6rem;border-radius:16px;background:rgba(255,255,255,.12);display:inline-flex;align-items:center;justify-content:center;border:2px solid rgba(255,255,255,.2)">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.7)" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/></svg>
        </div>
      <% } %>
    </div>

    <!-- Nombre y descripción alineados a la izquierda -->
    <div style="margin-bottom:1.5rem">
      <h1 style="font-size:clamp(1.5rem,4vw,2.25rem);font-weight:800;color:#fff;margin-bottom:.5rem;text-align:left"><%=business.name%></h1>
      <% if(business.description){ %>
        <p style="color:rgba(255,255,255,.78);font-size:.9rem;max-width:600px;line-height:1.65;text-align:left"><%=business.description%></p>
      <% } %>
    </div>

    <!-- Información alineada a la izquierda -->
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:1rem;justify-content:flex-start">
      <!-- WhatsApp -->
      <% if(business.whatsapp){ %>
      <a href="https://wa.me/<%=business.whatsapp.replace(/\D/g,'')%>?text=<%=encodeURIComponent('Hola, me interesa un producto de tu catálogo.')%>" target="_blank"
         style="display:inline-flex;align-items:center;gap:.625rem;background:#25D366;color:#fff;font-weight:700;font-size:.9375rem;padding:.85rem 1.75rem;border-radius:var(--r-btn);text-decoration:none;box-shadow:0 4px 14px rgba(37,211,102,.35);transition:var(--tr)"
         onmouseover="this.style.background='#1DA851'" onmouseout="this.style.background='#25D366'">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.534 5.858L0 24l6.335-1.524A11.935 11.935 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.8 9.8 0 01-5.012-1.375l-.36-.214-3.732.897.934-3.63-.236-.374A9.755 9.755 0 012.182 12c0-5.413 4.405-9.818 9.818-9.818 5.413 0 9.818 4.405 9.818 9.818 0 5.413-4.405 9.818-9.818 9.818z"/></svg>
        WhatsApp
      </a>
      <% } %>

      <!-- Teléfono -->
      <% if(business.phone){ %>
      <span style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);color:#fff;font-size:.85rem;font-weight:600;padding:.5rem 1rem;border-radius:99px;border:1px solid rgba(255,255,255,.18)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <%=business.phone%>
      </span>
      <% } %>

      <!-- Horario -->
      <% if(business.schedule){ %>
      <span style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);color:#fff;font-size:.85rem;font-weight:600;padding:.5rem 1rem;border-radius:99px;border:1px solid rgba(255,255,255,.18)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/></svg>
        <%=business.schedule%>
      </span>
      <% } %>

      <!-- Dirección -->
      <% if(business.address){ %>
      <span style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);color:#fff;font-size:.85rem;font-weight:600;padding:.5rem 1rem;border-radius:99px;border:1px solid rgba(255,255,255,.18)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <%=business.address%>
      </span>
      <% } %>
    </div>
  </div>
</header>

<!-- Catalog -->
<main style="padding:2.5rem 1.5rem;max-width:1280px;margin:0 auto;flex:1">

  <!-- Filters -->
  <div style="display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:2rem;align-items:center">
    <form method="GET" style="display:flex;flex-wrap:wrap;gap:.75rem;flex:1">
      <input type="text" name="search" value="<%=search%>" placeholder="Buscar productos..." class="input" style="flex:1;min-width:180px;max-width:360px" />
      <select name="category" class="input" style="width:auto;padding:.65rem 1rem;max-width:220px">
        <option value="all" <%=category==='all'?'selected':''%>>Todas las categorías</option>
        <% categories.forEach(c=>{ %><option value="<%=c%>" <%=category===c?'selected':''%>><%=c%></option><% }) %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
    </form>
    <button id="downloadPdf" class="btn btn-secondary btn-sm" style="display:inline-flex;align-items:center;gap:.5rem">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
      </svg>
      Descargar PDF
    </button>
  </div>

  <!-- Empty state -->
  <% if(products.length===0){ %>
  <div style="text-align:center;padding:5rem 1rem">
    <div style="width:4rem;height:4rem;background:var(--bg);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;border:1.5px solid var(--border)">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gray)" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
    <p style="font-weight:700;color:var(--dark);font-size:1.05rem">No se encontraron productos</p>
    <p style="color:var(--gray);font-size:.875rem;margin-top:.375rem">Intenta con otra búsqueda o categoría</p>
  </div>
  <% } else { %>

  <!-- Products grid -->
  <div id="productsGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.25rem">
    <% products.forEach(p=>{ %>
    <div class="card card-hover product-card"
         style="overflow:hidden;opacity:<%=p.status==='unavailable'?.6:1%>;cursor:pointer" 
         data-product='<%- JSON.stringify(p) %>'
         data-whatsapp="<%=business.whatsapp || ''%>">
      <!-- Botón Pedir (siempre visible arriba) -->
      <% if(p.status !== 'unavailable'){ %>
      <a href="<%=business.whatsapp ? 'https://wa.me/'+business.whatsapp.replace(/\D/g,'')+'?text='+encodeURIComponent('Hola! Me interesa: '+p.name+' ($'+parseFloat(p.price).toFixed(2)+')'+(p.stock_level==='low'?' - Pocas unidades disponibles':'')) : 'javascript:void(0)'%>"
         target="<%=business.whatsapp ? '_blank' : ''%>"
         class="whatsapp-btn-fixed"
         data-whatsapp="<%=business.whatsapp || ''%>"
         data-product-name="<%=p.name%>"
         data-product-price="<%=parseFloat(p.price).toFixed(2)%>"
         data-stock-level="<%=p.stock_level%>"
         style="position:absolute;top:.75rem;right:.75rem;z-index:10;display:inline-flex !important;align-items:center;gap:.375rem;background:#25D366;color:#fff;font-size:.75rem;font-weight:700;padding:.35rem .875rem;border-radius:7px;text-decoration:none;box-shadow:0 2px 8px rgba(37,211,102,.4);pointer-events:<%=business.whatsapp ? 'auto' : 'none'%>;opacity:1 !important">
        <svg width="13" height="13" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.534 5.858L0 24l6.335-1.524A11.935 11.935 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.8 9.8 0 01-5.012-1.375l-.36-.214-3.732.897.934-3.63-.236-.374A9.755 9.755 0 012.182 12c0-5.413 4.405-9.818 9.818-9.818 5.413 0 9.818 4.405 9.818 9.818 0 5.413-4.405 9.818-9.818 9.818z"/></svg>
        Pedir
      </a>
      <% } %>
      
      <div style="aspect-ratio:1;overflow:hidden;background:var(--bg)">
        <% if(p.image){ %>
          <img src="<%=p.image%>" alt="<%=p.name%>" class="product-image" style="width:100%;height:100%;object-fit:cover;transition:transform 320ms ease" />
        <% } else { %>
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D1D5DB" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        <% } %>
      </div>
      <div style="padding:1rem">
        <% if(p.category){ %><span class="badge badge-blue" style="margin-bottom:.5rem"><%=p.category%></span><% } %>
        <h3 style="font-size:.9375rem;font-weight:700;color:var(--dark);margin-top:.375rem;line-height:1.4;min-height:2.8rem;display:flex;align-items:center"><%=p.name%></h3>
        <% if(p.description && p.description.trim()){ %>
          <p style="font-size:.78rem;color:var(--gray);line-height:1.55;margin-top:.25rem"><%=p.description.length>70?p.description.slice(0,70)+'...':p.description%></p>
        <% } %>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:.875rem;flex-wrap:wrap;gap:.5rem">
          <span style="font-size:1.125rem;font-weight:800;color:var(--dark)">
            <%=p.currency==='CUP'?'$':'$'%><%=parseFloat(p.price).toFixed(2)%>
            <% if(p.currency==='CUP'){ %><span style="font-size:.625rem;font-weight:600;color:var(--gray);margin-left:.25rem">CUP</span><% } %>
          </span>
          <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;justify-content:flex-end">
            <% if(p.status==='unavailable'){ %>
              <span class="badge badge-red">Agotado</span>
            <% } else if(p.stock_level==='low'){ %>
              <span class="badge badge-yellow" style="display:inline-flex;align-items:center;gap:.25rem">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                Pocas
              </span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Pagination -->
  <% if(pages>1){ %>
  <div style="display:flex;justify-content:center;gap:.5rem;margin-top:2.5rem">
    <% for(let i=1;i<=pages;i++){ %>
      <a href="?page=<%=i%>&category=<%=category%>&search=<%=search%>"
         style="width:2.25rem;height:2.25rem;display:flex;align-items:center;justify-content:center;border-radius:8px;font-size:.875rem;font-weight:600;text-decoration:none;font-family:'Exo 2',sans-serif;transition:var(--tr);<%=i===currentPage?'background:var(--blue);color:#fff':'background:var(--white);color:var(--gray);border:1.5px solid var(--border)'%>"><%=i%></a>
    <% } %>
  </div>
  <% } %>
  <% } %>

  <!-- Social links -->
  <% var hasSocials=Object.values(socials).some(function(v){return v&&v.trim()}); %>
  <% if(hasSocials){ %>
  <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border);text-align:center">
    <p style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray);margin-bottom:.875rem">Redes sociales</p>
    <div style="display:flex;justify-content:center;flex-wrap:wrap;gap:1.25rem">
      <% if(socials.instagram){ %><a href="https://instagram.com/<%=socials.instagram.replace('@','')%>" target="_blank" style="font-size:.875rem;font-weight:600;color:#E1306C;text-decoration:none">Instagram</a><% } %>
      <% if(socials.facebook){ %><a href="https://facebook.com/<%=socials.facebook.replace('@','')%>" target="_blank" style="font-size:.875rem;font-weight:600;color:#1877F2;text-decoration:none">Facebook</a><% } %>
      <% if(socials.tiktok){ %><a href="https://tiktok.com/@<%=socials.tiktok.replace('@','')%>" target="_blank" style="font-size:.875rem;font-weight:600;color:var(--dark);text-decoration:none">TikTok</a><% } %>
    </div>
  </div>
  <% } %>
</main>

<!-- Product Modal -->
<div id="productModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;align-items:center;justify-content:center;padding:1.5rem">
  <div style="background:var(--white);border-radius:16px;max-width:500px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);position:relative">
    <button id="modalCloseBtn" style="position:absolute;top:1rem;right:1rem;width:2rem;height:2rem;border-radius:50%;border:1.5px solid var(--border);background:var(--white);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--tr)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gray)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <div id="modalContent"></div>
  </div>
</div>

<script>
// ── Event Delegation para todo ──────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  
  // 0. Botón Descargar PDF
  const downloadPdfBtn = document.getElementById('downloadPdf');
  const businessSlug = '<%= business.slug %>';
  
  if (downloadPdfBtn) {
    downloadPdfBtn.addEventListener('click', function() {
      window.open(`/shop/${businessSlug}/pdf`, '_blank');
    });
  }

  // 1. Click en cards de productos para abrir modal
  const productsGrid = document.getElementById('productsGrid');
  if (productsGrid) {
    productsGrid.addEventListener('click', function(e) {
      const card = e.target.closest('.product-card');
      if (!card) return;

      try {
        const productData = card.getAttribute('data-product');
        const whatsapp = card.getAttribute('data-whatsapp');
        const product = JSON.parse(productData);
        openProductModal(product, whatsapp);
      } catch (err) {
        console.error('Error al abrir modal del producto:', err);
      }
    });
  }

  // 2. Efecto hover en imágenes de productos
  document.querySelectorAll('.product-image').forEach(function(img) {
    img.addEventListener('mouseenter', function() {
      this.style.transform = 'scale(1.06)';
    });
    img.addEventListener('mouseleave', function() {
      this.style.transform = 'scale(1)';
    });
  });

  // 2b. Efecto hover en botones de WhatsApp
  document.querySelectorAll('.whatsapp-btn').forEach(function(btn) {
    btn.addEventListener('mouseenter', function() {
      this.style.background = '#1DA851';
    });
    btn.addEventListener('mouseleave', function() {
      this.style.background = '#25D366';
    });
  });
  
  // 2c. Efecto hover en botones fijos de productos
  document.querySelectorAll('.whatsapp-btn-fixed').forEach(function(btn) {
    btn.addEventListener('mouseenter', function() {
      if (this.getAttribute('data-whatsapp')) {
        this.style.background = '#1DA851';
      }
    });
    btn.addEventListener('mouseleave', function() {
      this.style.background = '#25D366';
    });
    
    // Manejar click en botones sin WhatsApp
    btn.addEventListener('click', function(e) {
      if (!this.getAttribute('data-whatsapp')) {
        e.preventDefault();
        return false;
      }
    });
  });

  // 3. Botón de cerrar modal
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const productModal = document.getElementById('productModal');
  
  if (modalCloseBtn && productModal) {
    modalCloseBtn.addEventListener('click', function() {
      closeProductModalDirect();
    });

    // 4. Cerrar modal al hacer click fuera del contenido
    productModal.addEventListener('click', function(e) {
      if (e.target === productModal) {
        closeProductModalDirect();
      }
    });
  }

  // 5. Cerrar modal con tecla Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeProductModalDirect();
    }
  });
});

// ── Funciones globales ──────────────────────────────────────────────────────

function openProductModal(product, whatsapp) {
  const modal = document.getElementById('productModal');
  const content = document.getElementById('modalContent');

  // Escapar caracteres especiales para HTML
  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  const whatsappMsg = whatsapp
    ? encodeURIComponent('Hola! Me interesa: ' + product.name + ' ($' + parseFloat(product.price).toFixed(2) + ')')
    : '';
  const whatsappLink = whatsapp ? 'https://wa.me/' + whatsapp.replace(/\D/g,'') + '?text=' + whatsappMsg : '#';

  content.innerHTML = `
    <div style="padding:0">
      <div style="aspect-ratio:1;overflow:hidden;background:var(--bg)">
        ${product.image
          ? `<img src="${escapeHtml(product.image)}" alt="${escapeHtml(product.name)}" style="width:100%;height:100%;object-fit:cover" />`
          : `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--bg)"><svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#D1D5DB" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>`
        }
      </div>

      <div style="padding:1.5rem">
        ${product.category ? `<span class="badge badge-blue" style="margin-bottom:.75rem;display:inline-flex">${escapeHtml(product.category)}</span>` : ''}

        <h2 style="font-size:1.25rem;font-weight:800;color:var(--dark);margin-bottom:.5rem;line-height:1.3">${escapeHtml(product.name)}</h2>

        ${product.description
          ? `<p style="color:var(--gray);line-height:1.65;margin-bottom:1rem;font-size:.9375rem">${escapeHtml(product.description)}</p>`
          : ''
        }

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;flex-wrap:wrap;gap:.75rem">
          <div>
            <span style="font-size:1.5rem;font-weight:800;color:var(--dark)">$${parseFloat(product.price).toFixed(2)}</span>
            ${product.currency === 'CUP' ? '<span style="font-size:.75rem;font-weight:600;color:var(--gray);margin-left:.375rem">CUP</span>' : ''}
          </div>
          ${product.status === 'unavailable'
            ? '<span class="badge badge-red" style="font-size:.8rem;padding:.4rem .9rem">Agotado</span>'
            : product.stock_level === 'low'
              ? '<span class="badge badge-yellow" style="font-size:.8rem;padding:.4rem .9rem;display:inline-flex;align-items:center;gap:.375rem"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg> Pocas disponibles</span>'
              : '<span class="badge badge-green" style="font-size:.8rem;padding:.4rem .9rem">Disponible</span>'
          }
        </div>

        ${whatsapp && product.status !== 'unavailable'
          ? `<a href="${whatsappLink}" target="_blank"
               style="display:flex;align-items:center;justify-content:center;gap:.625rem;background:#25D366;color:#fff;font-weight:700;font-size:1rem;padding:1rem 1.5rem;border-radius:var(--r-btn);text-decoration:none;box-shadow:0 4px 14px rgba(37,211,102,.35);transition:var(--tr)">
               <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.534 5.858L0 24l6.335-1.524A11.935 11.935 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.8 9.8 0 01-5.012-1.375l-.36-.214-3.732.897.934-3.63-.236-.374A9.755 9.755 0 012.182 12c0-5.413 4.405-9.818 9.818-9.818 5.413 0 9.818 4.405 9.818 9.818 0 5.413-4.405 9.818-9.818 9.818z"/></svg>
               Contactar por WhatsApp
             </a>`
          : ''
        }
      </div>
    </div>
  `;

  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeProductModalDirect() {
  const modal = document.getElementById('productModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}
</script>

<footer style="background:var(--white);border-top:1px solid var(--border);padding:1.25rem 1.5rem;text-align:center">
  <p style="font-size:.78rem;color:var(--gray)">Catálogo creado con <a href="/" style="color:var(--blue);font-weight:700;text-decoration:none">DevisiStore</a></p>
</footer>

</body>
</html>
