<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div style="background:var(--bg);min-height:calc(100vh - var(--nav-h));padding:2rem 1.5rem;flex:1">
  <div style="max-width:1100px;margin:0 auto">

    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)">
      <div style="width:3rem;height:3rem;background:linear-gradient(135deg,var(--blue) 0%,var(--green) 100%);border-radius:12px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(46,95,168,.25);flex-shrink:0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <div>
        <h1 class="section-title">Panel de Administración</h1>
        <p class="section-sub">Gestión global de la plataforma DevisiStore</p>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.25rem;margin-bottom:2.5rem">

      <a href="/admin/users" class="card card-hover" style="padding:1.5rem;text-decoration:none;display:flex;gap:1rem;align-items:center">
        <div style="width:2.75rem;height:2.75rem;background:var(--blue-light);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div><p style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray)">Usuarios</p><p style="font-size:2rem;font-weight:800;color:var(--dark)"><%=stats.users%></p></div>
      </a>

      <a href="/admin/businesses" class="card card-hover" style="padding:1.5rem;text-decoration:none;display:flex;gap:1rem;align-items:center">
        <div style="width:2.75rem;height:2.75rem;background:var(--green-light);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <div><p style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray)">Negocios</p><p style="font-size:2rem;font-weight:800;color:var(--dark)"><%=stats.businesses%></p></div>
      </a>

      <a href="/admin/keys" class="card card-hover" style="padding:1.5rem;text-decoration:none;display:flex;gap:1rem;align-items:center">
        <div style="width:2.75rem;height:2.75rem;background:#FFFBEB;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid #FDE68A">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        </div>
        <div><p style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray)">Claves libres</p><p style="font-size:2rem;font-weight:800;color:var(--dark)"><%=stats.keys%></p></div>
      </a>

    </div>

    <!-- Quick links -->
    <h2 style="font-size:1rem;font-weight:700;color:var(--dark);margin-bottom:1rem">Acceso rápido</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
      <% [
        {href:'/admin/keys',  icon:'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z', t:'Claves de acceso', d:'Genera y gestiona invitaciones', c:'var(--blue)'},
        {href:'/admin/users', icon:'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z', t:'Usuarios', d:'Activar, desactivar o eliminar', c:'var(--green)'},
        {href:'/admin/businesses',icon:'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4', t:'Negocios', d:'Ver y moderar catálogos', c:'var(--blue)'},
      ].forEach(l=>{ %>
      <a href="<%=l.href%>" class="card card-hover" style="padding:1.25rem;display:flex;align-items:center;gap:.875rem;text-decoration:none">
        <div style="width:2.5rem;height:2.5rem;background:var(--blue-light);border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="<%=l.c%>" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="<%=l.icon%>"/></svg>
        </div>
        <div style="flex:1;min-width:0">
          <p style="font-weight:700;color:var(--dark);font-size:.9375rem"><%=l.t%></p>
          <p style="font-size:.78rem;color:var(--gray);margin-top:.15rem"><%=l.d%></p>
        </div>
        <svg style="color:var(--gray);flex-shrink:0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
      <% }) %>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
</body>
</html>
