<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div style="background:var(--bg);min-height:calc(100vh - 3.75rem);padding:2rem 1.5rem">
  <div style="max-width:1100px;margin:0 auto">

    <!-- Header -->
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)">
      <div style="width:3rem;height:3rem;background:linear-gradient(135deg,var(--blue) 0%,var(--green) 100%);border-radius:12px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(46,95,168,.25)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <div>
        <h1 class="section-title">Panel de Administración</h1>
        <p class="section-sub">Gestión global de la plataforma DevisiStore</p>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.25rem;margin-bottom:2.5rem">
      <a href="/admin/users" class="card card-hover" style="padding:1.5rem;text-decoration:none;display:flex;gap:1rem;align-items:center">
        <div style="width:3rem;height:3rem;background:var(--blue-light);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0">👥</div>
        <div><p style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--gray)">Usuarios</p><p style="font-size:2rem;font-weight:800;color:var(--dark)"><%=stats.users%></p></div>
      </a>
      <a href="/admin/businesses" class="card card-hover" style="padding:1.5rem;text-decoration:none;display:flex;gap:1rem;align-items:center">
        <div style="width:3rem;height:3rem;background:var(--green-light);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0">🏪</div>
        <div><p style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--gray)">Negocios</p><p style="font-size:2rem;font-weight:800;color:var(--dark)"><%=stats.businesses%></p></div>
      </a>
      <a href="/admin/keys" class="card card-hover" style="padding:1.5rem;text-decoration:none;display:flex;gap:1rem;align-items:center">
        <div style="width:3rem;height:3rem;background:#FFFBEB;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0">🔑</div>
        <div><p style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--gray)">Claves libres</p><p style="font-size:2rem;font-weight:800;color:var(--dark)"><%=stats.keys%></p></div>
      </a>
    </div>

    <!-- Quick nav -->
    <h2 style="font-size:1rem;font-weight:700;color:var(--dark);margin-bottom:1rem">Acceso rápido</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
      <% const links=[
        {href:'/admin/keys',icon:'🔑',t:'Claves de acceso',d:'Genera y gestiona invitaciones'},
        {href:'/admin/users',icon:'👥',t:'Usuarios',d:'Activar, desactivar o eliminar'},
        {href:'/admin/businesses',icon:'🏪',t:'Negocios',d:'Ver y moderar catálogos'},
      ]; links.forEach(l=>{ %>
      <a href="<%=l.href%>" class="card card-hover" style="padding:1.25rem;display:flex;align-items:center;gap:.875rem;text-decoration:none">
        <span style="font-size:1.5rem"><%=l.icon%></span>
        <div><p style="font-weight:700;color:var(--dark);font-size:.9375rem"><%=l.t%></p><p style="font-size:.78rem;color:var(--gray);margin-top:.15rem"><%=l.d%></p></div>
        <svg style="margin-left:auto;color:var(--gray);flex-shrink:0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
      <% }) %>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
</body>
</html>
