<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div style="background:var(--bg);min-height:calc(100vh - 3.75rem);padding:2rem 1.5rem">
  <div style="max-width:1000px;margin:0 auto">

    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem">
      <div>
        <a href="/admin" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.8rem;font-weight:600;color:var(--gray);text-decoration:none;margin-bottom:.5rem" onmouseover="this.style.color='var(--blue)'" onmouseout="this.style.color='var(--gray)'">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg> Panel admin
        </a>
        <h1 class="section-title">Claves de acceso</h1>
        <p class="section-sub">Genera claves para invitar nuevos usuarios.</p>
      </div>
      <form action="/admin/keys/generate" method="POST" style="margin:0">
        <button class="btn-primary" style="font-family:'Exo 2',sans-serif">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Generar clave
        </button>
      </form>
    </div>

    <%- include('../partials/flash') %>

    <div class="card" style="overflow:hidden">
      <table class="ds-table">
        <thead><tr>
          <th>Clave</th><th>Estado</th><th>Usada por</th><th>Fecha</th><th style="text-align:right">Acciones</th>
        </tr></thead>
        <tbody>
          <% if(keys.length===0){ %>
          <tr><td colspan="5" style="text-align:center;padding:3rem;color:var(--gray)">No hay claves generadas aún.</td></tr>
          <% } %>
          <% keys.forEach(k=>{ %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:.625rem">
                <code style="background:var(--blue-light);color:var(--blue-dark);padding:.25rem .75rem;border-radius:7px;font-size:.875rem;font-weight:700;letter-spacing:.08em"><%=k.key_value%></code>
                <button onclick="navigator.clipboard.writeText('<%=k.key_value%>');this.textContent='✓'" style="background:none;border:none;cursor:pointer;color:var(--gray);font-size:.875rem" title="Copiar">📋</button>
              </div>
            </td>
            <td><span class="<%=k.used?'badge-gray':'badge-green'%>"><%=k.used?'Utilizada':'Disponible'%></span></td>
            <td style="color:var(--gray);font-size:.8rem"><%=k.used_by_email||'—'%></td>
            <td style="color:var(--gray);font-size:.8rem"><%=new Date(k.created_at).toLocaleDateString('es')%></td>
            <td style="text-align:right">
              <% if(!k.used){ %>
              <form action="/admin/keys/<%=k.id%>/delete" method="POST" onsubmit="return confirm('¿Eliminar esta clave?')" style="margin:0">
                <button class="btn-danger" style="font-family:'Exo 2',sans-serif">Eliminar</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
</body>
</html>
