<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div style="background:var(--bg);min-height:calc(100vh - var(--nav-h));padding:2rem 1.5rem;flex:1">
  <div style="max-width:1000px;margin:0 auto">
    <a href="/admin" class="back-link">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Panel admin
    </a>
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem">
      <div>
        <h1 class="section-title">Claves de acceso</h1>
        <p class="section-sub">Genera claves para invitar nuevos usuarios.</p>
      </div>
      <form action="/admin/keys/generate" method="POST" style="margin:0">
        <button class="btn btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Generar clave
        </button>
      </form>
    </div>
    <%- include('../partials/flash') %>
    <div class="card" style="overflow:hidden">
      <div style="overflow-x:auto">
        <table class="ds-table">
          <thead><tr>
            <th>Clave</th><th>Estado</th>
            <th class="col-hide-sm">Usada por</th>
            <th class="col-hide-sm">Fecha</th>
            <th style="text-align:right">Acciones</th>
          </tr></thead>
          <tbody>
            <% if(!keys.length){ %>
            <tr><td colspan="5" style="text-align:center;padding:3rem;color:var(--gray)">No hay claves generadas.</td></tr>
            <% } %>
            <% keys.forEach(k=>{ %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:.625rem">
                  <code style="background:var(--blue-light);color:var(--blue-dark);padding:.25rem .75rem;border-radius:7px;font-size:.875rem;font-weight:700;letter-spacing:.07em"><%=k.key_value%></code>
                  <button class="copyKeyBtn" data-key="<%=k.key_value%>" style="background:none;border:1px solid var(--border);border-radius:6px;cursor:pointer;color:var(--gray);font-size:.75rem;padding:.2rem .5rem;font-family:'Exo 2',sans-serif;transition:var(--tr)">
                    <span class="copyKeyText">Copiar</span>
                  </button>
                </div>
              </td>
              <td><span class="badge <%=k.used?'badge-gray':'badge-green'%>"><%=k.used?'Utilizada':'Disponible'%></span></td>
              <td class="col-hide-sm" style="color:var(--gray);font-size:.8rem"><%=k.used_by_email||'—'%></td>
              <td class="col-hide-sm" style="color:var(--gray);font-size:.8rem"><%=new Date(k.created_at).toLocaleDateString('es')%></td>
              <td style="text-align:right">
                <% if(!k.used){ %>
                <form action="/admin/keys/<%=k.id%>/delete" method="POST" class="deleteKeyForm" style="margin:0">
                  <button class="btn btn-danger">Eliminar</button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Copy key functionality
  document.querySelectorAll('.copyKeyBtn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const key = this.getAttribute('data-key');
      const textEl = this.querySelector('.copyKeyText');
      navigator.clipboard.writeText(key).then(() => {
        textEl.textContent = '¡Copiado!';
        this.style.background = 'var(--green-light)';
        this.style.color = 'var(--green-dark)';
        setTimeout(() => {
          textEl.textContent = 'Copiar';
          this.style.background = 'none';
          this.style.color = 'var(--gray)';
        }, 2000);
      });
    });
    btn.addEventListener('mouseenter', function() {
      this.style.background = 'var(--blue-light)';
    });
    btn.addEventListener('mouseleave', function() {
      this.style.background = 'none';
    });
  });

  // Delete key confirmation
  document.querySelectorAll('.deleteKeyForm').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      if (!confirm('¿Eliminar esta clave de acceso?')) {
        e.preventDefault();
      }
    });
  });
});
</script>

<%- include('../partials/footer') %>
</body>
</html>
