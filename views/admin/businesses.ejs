<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Negocios</h1>
        <p class="text-gray-500 mt-1"><%= businesses.length %> negocio(s) registrados.</p>
      </div>
      <a href="/admin" class="text-sm text-brand-600 hover:underline">← Volver al panel</a>
    </div>

    <%- include('../partials/flash') %>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="text-left px-5 py-3.5 font-semibold text-gray-600">Negocio</th>
            <th class="text-left px-5 py-3.5 font-semibold text-gray-600">Propietario</th>
            <th class="text-left px-5 py-3.5 font-semibold text-gray-600">Slug / URL</th>
            <th class="text-left px-5 py-3.5 font-semibold text-gray-600">Estado</th>
            <th class="text-right px-5 py-3.5 font-semibold text-gray-600">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% if (businesses.length === 0) { %>
            <tr><td colspan="5" class="text-center py-10 text-gray-400">No hay negocios aún.</td></tr>
          <% } %>
          <% businesses.forEach(b => { %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-5 py-4 flex items-center gap-3">
              <% if (b.logo) { %>
                <img src="<%= b.logo %>" alt="Logo" class="w-10 h-10 rounded-xl object-cover border border-gray-200 flex-shrink-0" />
              <% } else { %>
                <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center text-lg flex-shrink-0">🏪</div>
              <% } %>
              <span class="font-medium text-gray-900"><%= b.name %></span>
            </td>
            <td class="px-5 py-4 text-gray-500 text-xs"><%= b.owner_email %></td>
            <td class="px-5 py-4">
              <a href="/shop/<%= b.slug %>" target="_blank"
                 class="text-brand-600 hover:underline font-mono text-xs">/shop/<%= b.slug %></a>
            </td>
            <td class="px-5 py-4">
              <span class="px-2.5 py-1 rounded-full text-xs font-medium
                           <%= b.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                <%= b.active ? 'Activo' : 'Inactivo' %>
              </span>
            </td>
            <td class="px-5 py-4 text-right">
              <form action="/admin/businesses/<%= b.id %>/toggle" method="POST">
                <button class="text-xs px-3 py-1.5 rounded-lg font-medium transition
                               <%= b.active ? 'bg-yellow-50 text-yellow-700 hover:bg-yellow-100' : 'bg-green-50 text-green-700 hover:bg-green-100' %>">
                  <%= b.active ? 'Desactivar' : 'Activar' %>
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
</body>
</html>
