<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div style="background:var(--bg);min-height:calc(100vh - var(--nav-h));padding:2rem 1.5rem;flex:1">
  <div style="max-width:1100px;margin:0 auto">
    <a href="/admin" class="back-link">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Panel admin
    </a>
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem">
      <div>
        <h1 class="section-title">Planes</h1>
        <p class="section-sub">Gestiona los planes disponibles en la plataforma</p>
      </div>
      <button id="newPlanBtn" class="btn btn-primary btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:.375rem"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Nuevo plan
      </button>
    </div>
    <%- include('../partials/flash') %>

    <!-- Plans Grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem;margin-bottom:2rem">
      <% plans.forEach(p=>{ %>
      <div class="card" style="padding:1.5rem;opacity:<%=p.is_active?1:0.6%>">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem">
          <div>
            <h3 style="font-size:1.125rem;font-weight:800;color:var(--dark)"><%=p.name%></h3>
            <p style="font-size:.8125rem;color:var(--gray);margin-top:.25rem"><%=p.description||''%></p>
          </div>
          <span class="badge <%=p.is_active?'badge-green':'badge-red'%>"><%=p.is_active?'Activo':'Inactivo'%></span>
        </div>

        <div style="margin-bottom:1rem">
          <p style="font-size:1.5rem;font-weight:800;color:var(--blue)">$<%=parseFloat(p.price).toFixed(2)%> <span style="font-size:.75rem;font-weight:600;color:var(--gray)">/<%=p.billing_period==='monthly'?'mes':'año'%></span></p>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem">
          <span class="badge badge-blue"><%=p.max_businesses===-1?'∞':p.max_businesses%> negocios</span>
          <span class="badge badge-blue"><%=p.max_products===-1?'∞':p.max_products%> productos</span>
          <span class="badge badge-blue"><%=p.max_storage_mb%> MB</span>
          <% if(p.enable_cart){ %><span class="badge badge-green">Carrito</span><% } %>
          <% if(p.enable_custom_domain){ %><span class="badge badge-green">Dominio</span><% } %>
        </div>

        <div style="display:flex;gap:.5rem;flex-wrap:wrap">
          <button class="editPlanBtn btn btn-ghost btn-sm" data-plan='<%- JSON.stringify(p) %>'>Editar</button>
          <form action="/admin/plans/<%=p.id%>/toggle" method="POST" style="margin:0">
            <button class="btn <%=p.is_active?'btn-warn':'btn-secondary'%> btn-sm"><%=p.is_active?'Desactivar':'Activar'%></button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Plan Modal -->
<div id="planModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;align-items:center;justify-content:center;padding:1.5rem">
  <div style="background:var(--white);border-radius:16px;max-width:600px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);position:relative">
    <button id="planModalClose" style="position:absolute;top:1rem;right:1rem;width:2rem;height:2rem;border-radius:50%;border:1.5px solid var(--border);background:var(--white);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:10">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gray)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <div style="padding:1.5rem">
      <h2 id="planModalTitle" style="font-size:1.25rem;font-weight:800;color:var(--dark);margin-bottom:1.5rem">Nuevo plan</h2>
      
      <form id="planForm" method="POST" action="/admin/plans" style="display:flex;flex-direction:column;gap:1.25rem">
        <input type="hidden" id="planId" name="_method" value="" />
        
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div>
            <label class="label" for="planName">Nombre <span style="color:#DC2626">*</span></label>
            <input id="planName" name="name" type="text" required class="input" placeholder="Ej: Profesional" />
          </div>
          <div>
            <label class="label" for="planSlug">Slug <span style="color:#DC2626">*</span></label>
            <input id="planSlug" name="slug" type="text" required class="input" placeholder="pro" style="text-transform:lowercase" />
          </div>
        </div>

        <div>
          <label class="label" for="planDesc">Descripción</label>
          <textarea id="planDesc" name="description" rows="2" class="input" placeholder="Descripción breve del plan..."></textarea>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem">
          <div>
            <label class="label" for="planPrice">Precio</label>
            <input id="planPrice" name="price" type="number" step="0.01" min="0" value="0" class="input" />
          </div>
          <div>
            <label class="label" for="planCurrency">Moneda</label>
            <select id="planCurrency" name="currency" class="input">
              <option value="USD">USD</option>
              <option value="CUP">CUP</option>
            </select>
          </div>
          <div>
            <label class="label" for="planBilling">Período</label>
            <select id="planBilling" name="billing_period" class="input">
              <option value="monthly">Mensual</option>
              <option value="yearly">Anual</option>
            </select>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem">
          <div>
            <label class="label" for="planBusinesses">Máx. negocios</label>
            <input id="planBusinesses" name="max_businesses" type="number" value="1" class="input" />
            <p style="font-size:.625rem;color:var(--gray);margin-top:.25rem">-1 = ilimitado</p>
          </div>
          <div>
            <label class="label" for="planProducts">Máx. productos</label>
            <input id="planProducts" name="max_products" type="number" value="50" class="input" />
            <p style="font-size:.625rem;color:var(--gray);margin-top:.25rem">-1 = ilimitado</p>
          </div>
          <div>
            <label class="label" for="planStorage">Almacenamiento (MB)</label>
            <input id="planStorage" name="max_storage_mb" type="number" value="100" class="input" />
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <label style="display:flex;align-items:center;gap:.5rem;font-size:.875rem;color:var(--dark)">
            <input type="checkbox" name="enable_cart" value="1" /> Carrito de compras
          </label>
          <label style="display:flex;align-items:center;gap:.5rem;font-size:.875rem;color:var(--dark)">
            <input type="checkbox" name="enable_custom_domain" value="1" /> Dominio personalizado
          </label>
          <label style="display:flex;align-items:center;gap:.5rem;font-size:.875rem;color:var(--dark)">
            <input type="checkbox" name="enable_analytics" value="1" /> Analíticas
          </label>
          <label style="display:flex;align-items:center;gap:.5rem;font-size:.875rem;color:var(--dark)">
            <input type="checkbox" name="enable_priority_support" value="1" /> Soporte prioritario
          </label>
        </div>

        <div style="display:flex;gap:.5rem;justify-content:flex-end;padding-top:.5rem;border-top:1px solid var(--border)">
          <button type="button" id="planCancelBtn" class="btn btn-ghost">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar plan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const planModal = document.getElementById('planModal');
  const newPlanBtn = document.getElementById('newPlanBtn');
  const planModalClose = document.getElementById('planModalClose');
  const planCancelBtn = document.getElementById('planCancelBtn');
  const planForm = document.getElementById('planForm');
  const planModalTitle = document.getElementById('planModalTitle');

  function openModal(plan = null) {
    planForm.reset();
    
    if (plan) {
      planModalTitle.textContent = 'Editar plan';
      planForm.action = `/admin/plans/${plan.id}`;
      document.getElementById('planName').value = plan.name;
      document.getElementById('planSlug').value = plan.slug;
      document.getElementById('planDesc').value = plan.description || '';
      document.getElementById('planPrice').value = plan.price;
      document.getElementById('planCurrency').value = plan.currency || 'USD';
      document.getElementById('planBilling').value = plan.billing_period || 'monthly';
      document.getElementById('planBusinesses').value = plan.max_businesses;
      document.getElementById('planProducts').value = plan.max_products;
      document.getElementById('planStorage').value = plan.max_storage_mb;
      planForm.querySelector('[name="enable_cart"]').checked = plan.enable_cart;
      planForm.querySelector('[name="enable_custom_domain"]').checked = plan.enable_custom_domain;
      planForm.querySelector('[name="enable_analytics"]').checked = plan.enable_analytics;
      planForm.querySelector('[name="enable_priority_support"]').checked = plan.enable_priority_support;
    } else {
      planModalTitle.textContent = 'Nuevo plan';
      planForm.action = '/admin/plans';
    }
    
    planModal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    planModal.style.display = 'none';
    document.body.style.overflow = '';
  }

  newPlanBtn.addEventListener('click', () => openModal());
  planModalClose.addEventListener('click', closeModal);
  planCancelBtn.addEventListener('click', closeModal);
  planModal.addEventListener('click', function(e) {
    if (e.target === planModal) closeModal();
  });

  document.querySelectorAll('.editPlanBtn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const plan = JSON.parse(this.getAttribute('data-plan'));
      openModal(plan);
    });
  });
});
</script>

<%- include('../partials/footer') %>
</body>
</html>
