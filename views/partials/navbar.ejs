<nav style="background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:50;box-shadow:0 1px 4px rgba(46,95,168,.06);height:var(--nav-h)">
  <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:100%">

    <!-- Logo -->
    <a href="/" style="text-decoration:none;display:flex;align-items:center">
      <img src="/assets/logo.png" alt="Devisi Store" class="app-logo"
           onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
      <!-- Fallback text logo when PNG is missing -->
      <span style="display:none;align-items:center;gap:.5rem;font-weight:800;font-size:1.05rem">
        <span style="color:var(--blue)">Devisi</span><span style="color:var(--green)">Store</span>
      </span>
    </a>

    <!-- Mobile menu button -->
    <button id="mobileMenuBtn" style="display:none;background:none;border:none;cursor:pointer;padding:.5rem;border-radius:8px;transition:var(--tr)">
      <svg id="menuIcon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dark)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="closeIcon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dark)" stroke-width="2" style="display:none"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Desktop nav -->
    <div id="desktopNav" style="display:flex;align-items:center;gap:.5rem">
      <a href="/businesses" class="main-nav-link" style="font-size:.875rem;font-weight:600;color:var(--gray);text-decoration:none;padding:.4rem .875rem;border-radius:8px;transition:var(--tr)">Negocios</a>
      <% if (locals.user) { %>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="main-nav-link" style="font-size:.875rem;font-weight:600;color:var(--gray);text-decoration:none;padding:.4rem .875rem;border-radius:8px;transition:var(--tr)">Admin</a>
        <% } %>
        <a href="/dashboard" class="main-nav-link" style="font-size:.875rem;font-weight:600;color:var(--gray);text-decoration:none;padding:.4rem .875rem;border-radius:8px;transition:var(--tr)">Mi Panel</a>
        <form action="/auth/logout" method="POST" style="margin:0">
          <button class="btn btn-ghost btn-sm">Salir</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="main-nav-link" style="font-size:.875rem;font-weight:600;color:var(--gray);text-decoration:none;padding:.4rem .875rem;border-radius:8px;transition:var(--tr)">Iniciar sesión</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Registrarse</a>
      <% } %>
    </div>
  </div>

  <!-- Mobile nav menu -->
  <div id="mobileMenu" style="display:none;background:var(--white);border-top:1px solid var(--border);padding:1rem 1.5rem;position:absolute;top:var(--nav-h);left:0;right:0;box-shadow:0 4px 12px rgba(0,0,0,.1);z-index:40">
    <div style="display:flex;flex-direction:column;gap:.75rem">
      <a href="/businesses" style="font-size:.9375rem;font-weight:600;color:var(--dark);text-decoration:none;padding:.625rem .875rem;border-radius:8px;transition:var(--tr);background:var(--bg)">
        <span style="display:inline-flex;align-items:center;gap:.5rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/></svg>
          Negocios
        </span>
      </a>
      <% if (locals.user) { %>
        <% if (user.role === 'admin') { %>
          <a href="/admin" style="font-size:.9375rem;font-weight:600;color:var(--dark);text-decoration:none;padding:.625rem .875rem;border-radius:8px;transition:var(--tr)">
            <span style="display:inline-flex;align-items:center;gap:.5rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Admin
            </span>
          </a>
        <% } %>
        <a href="/dashboard" style="font-size:.9375rem;font-weight:600;color:var(--dark);text-decoration:none;padding:.625rem .875rem;border-radius:8px;transition:var(--tr)">
          <span style="display:inline-flex;align-items:center;gap:.5rem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Mi Panel
          </span>
        </a>
        <form action="/auth/logout" method="POST" style="margin:0">
          <button type="submit" style="width:100%;font-size:.9375rem;font-weight:600;color:var(--red,#DC2626);text-decoration:none;padding:.625rem .875rem;border-radius:8px;transition:var(--tr);background:#FEF2F2;border:1px solid #FECACA;text-align:left">
            <span style="display:inline-flex;align-items:center;gap:.5rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              Cerrar sesión
            </span>
          </button>
        </form>
      <% } else { %>
        <a href="/auth/login" style="font-size:.9375rem;font-weight:600;color:var(--dark);text-decoration:none;padding:.625rem .875rem;border-radius:8px;transition:var(--tr)">
          <span style="display:inline-flex;align-items:center;gap:.5rem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v7"/></svg>
            Iniciar sesión
          </span>
        </a>
        <a href="/auth/register" style="display:flex;align-items:center;justify-content:center;gap:.5rem;font-size:.9375rem;font-weight:700;color:#fff;text-decoration:none;padding:.75rem 1rem;border-radius:10px;background:var(--blue);box-shadow:0 2px 8px rgba(46,95,168,.24);transition:var(--tr)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Registrarse
        </a>
      <% } %>
    </div>
  </div>
</nav>

<script>
// Mobile menu toggle
document.addEventListener('DOMContentLoaded', function() {
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const menuIcon = document.getElementById('menuIcon');
  const closeIcon = document.getElementById('closeIcon');
  const desktopNav = document.getElementById('desktopNav');

  function isMobile() {
    return window.innerWidth <= 768;
  }

  function toggleMenu() {
    const isOpen = mobileMenu.style.display === 'block';
    mobileMenu.style.display = isOpen ? 'none' : 'block';
    menuIcon.style.display = isOpen ? 'block' : 'none';
    closeIcon.style.display = isOpen ? 'none' : 'block';
    
    // Prevenir scroll cuando el menú está abierto
    if (!isOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  }

  function closeMenu() {
    mobileMenu.style.display = 'none';
    menuIcon.style.display = 'block';
    closeIcon.style.display = 'none';
    document.body.style.overflow = '';
  }

  // Mostrar/ocultar botón móvil según tamaño de pantalla
  function updateMenuDisplay() {
    if (isMobile()) {
      mobileMenuBtn.style.display = 'block';
      desktopNav.style.display = 'none';
    } else {
      mobileMenuBtn.style.display = 'none';
      desktopNav.style.display = 'flex';
      closeMenu();
    }
  }

  // Event listeners
  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', toggleMenu);
  }

  // Cerrar menú al hacer click en un enlace
  if (mobileMenu) {
    mobileMenu.querySelectorAll('a, button').forEach(function(el) {
      el.addEventListener('click', closeMenu);
    });
  }

  // Cerrar menú al hacer click fuera
  document.addEventListener('click', function(e) {
    if (isMobile() && mobileMenu.style.display === 'block' && 
        !mobileMenu.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
      closeMenu();
    }
  });

  // Cerrar con tecla Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && isMobile() && mobileMenu.style.display === 'block') {
      closeMenu();
    }
  });

  // Inicializar
  updateMenuDisplay();
  window.addEventListener('resize', updateMenuDisplay);
  
  // Efecto hover en botón móvil
  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('mouseenter', function() {
      this.style.background = 'var(--bg)';
    });
    mobileMenuBtn.addEventListener('mouseleave', function() {
      this.style.background = 'none';
    });
  }

  // Efecto hover en links de nav principal
  document.querySelectorAll('.main-nav-link').forEach(function(link) {
    link.addEventListener('mouseenter', function() {
      this.style.color = 'var(--blue)';
      this.style.background = 'var(--blue-light)';
    });
    link.addEventListener('mouseleave', function() {
      this.style.color = 'var(--gray)';
      this.style.background = 'transparent';
    });
  });
});
</script>
