<nav class="bg-white border-b border-gray-100 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 bg-brand-600 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M4 6h16M4 10h16M4 14h8M4 18h8M14 14l2 2 4-4"/>
          </svg>
        </div>
        <span class="font-bold text-xl text-brand-700">CatalogHub</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-4">
        <% if (locals.user) { %>
          <% if (user.role === 'admin') { %>
            <a href="/admin"     class="text-sm text-gray-600 hover:text-brand-600 font-medium">Admin</a>
          <% } %>
          <a href="/dashboard"   class="text-sm text-gray-600 hover:text-brand-600 font-medium">Mi Panel</a>
          <form action="/auth/logout" method="POST" class="inline">
            <button class="text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition">
              Cerrar sesión
            </button>
          </form>
        <% } else { %>
          <a href="/auth/login"    class="text-sm text-gray-600 hover:text-brand-600 font-medium">Iniciar sesión</a>
          <a href="/auth/register" class="text-sm bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg font-medium transition">
            Registrarse
          </a>
        <% } %>
      </div>

      <!-- Mobile menu button -->
      <button id="mobileBtn" class="md:hidden p-2 rounded-lg hover:bg-gray-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobileMenu" class="hidden md:hidden pb-4 space-y-2">
      <% if (locals.user) { %>
        <a href="/dashboard"   class="block px-3 py-2 rounded-lg text-sm hover:bg-gray-50">Mi Panel</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin"     class="block px-3 py-2 rounded-lg text-sm hover:bg-gray-50">Admin</a>
        <% } %>
        <form action="/auth/logout" method="POST">
          <button class="w-full text-left px-3 py-2 rounded-lg text-sm hover:bg-gray-50">
            Cerrar sesión
          </button>
        </form>
      <% } else { %>
        <a href="/auth/login"    class="block px-3 py-2 rounded-lg text-sm hover:bg-gray-50">Iniciar sesión</a>
        <a href="/auth/register" class="block px-3 py-2 rounded-lg text-sm bg-brand-600 text-white rounded-lg">Registrarse</a>
      <% } %>
    </div>
  </div>
</nav>

<script>
  document.getElementById('mobileBtn').addEventListener('click', () => {
    document.getElementById('mobileMenu').classList.toggle('hidden');
  });
</script>
