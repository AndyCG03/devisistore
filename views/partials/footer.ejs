<footer style="background:var(--white);border-top:1px solid var(--border);margin-top:auto">
  <div style="max-width:1200px;margin:0 auto;padding:1.25rem 1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
    <a href="/" style="display:flex;align-items:center;gap:.5rem;text-decoration:none">
      <div class="logo-mark" style="width:1.75rem;height:1.75rem;border-radius:7px">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
      </div>
      <span style="font-weight:800;font-size:.9rem;color:var(--blue)">Devisi</span><span style="font-weight:800;font-size:.9rem;color:var(--green)">Store</span>
    </a>
    <p style="font-size:.8rem;color:var(--gray)">&copy; <%= new Date().getFullYear() %> DevisiStore. Tu catálogo online profesional.</p>
  </div>
</footer>
