<footer style="background:var(--white);border-top:1px solid var(--border);margin-top:auto">
  <div style="max-width:1280px;margin:0 auto;padding:1.125rem 1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem">
    <a href="/" style="text-decoration:none;display:flex;align-items:center">
      <img src="/assets/logo.png" alt="Devisi Store" class="app-logo-sm"
           onerror="this.style.display='none';this.nextElementSibling.style.display='inline'" />
      <span style="display:none;font-weight:800;font-size:.875rem">
        <span style="color:var(--blue)">Devisi</span><span style="color:var(--green)">Store</span>
      </span>
    </a>
    <p style="font-size:.78rem;color:var(--gray)">&copy; <%= new Date().getFullYear() %> DevisiStore — Tu catálogo online profesional.</p>
  </div>
</footer>
