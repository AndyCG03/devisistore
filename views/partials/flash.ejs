<% if (locals.flashSuccess) { %>
<div id="flash-success"
     class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl mb-6 shadow-sm">
  <svg class="w-5 h-5 flex-shrink-0 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
  </svg>
  <p class="text-sm font-medium"><%= flashSuccess %></p>
  <button onclick="this.parentElement.remove()" class="ml-auto text-green-400 hover:text-green-600">✕</button>
</div>
<% } %>

<% if (locals.flashError) { %>
<div id="flash-error"
     class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-6 shadow-sm">
  <svg class="w-5 h-5 flex-shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
  </svg>
  <p class="text-sm font-medium"><%= flashError %></p>
  <button onclick="this.parentElement.remove()" class="ml-auto text-red-400 hover:text-red-600">✕</button>
</div>
<% } %>

<script>
  // Auto-ocultar mensajes tras 5 segundos
  setTimeout(() => {
    ['flash-success','flash-error'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.transition = 'opacity .5s', el.style.opacity = '0',
               setTimeout(() => el.remove(), 500);
    });
  }, 5000);
</script>
