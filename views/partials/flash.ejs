<% if (locals.flashSuccess) { %>
<div id="flash-s" style="display:flex;align-items:center;gap:.75rem;background:var(--green-light);border:1.5px solid rgba(42,168,101,.25);color:var(--green-dark);padding:.875rem 1rem;border-radius:10px;margin-bottom:1.5rem;font-size:.875rem;font-weight:600">
  <svg style="flex-shrink:0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
  <span><%= flashSuccess %></span>
  <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;cursor:pointer;color:var(--green-dark);font-size:1rem;line-height:1">✕</button>
</div>
<% } %>
<% if (locals.flashError) { %>
<div id="flash-e" style="display:flex;align-items:center;gap:.75rem;background:#FEF2F2;border:1.5px solid #FECACA;color:#DC2626;padding:.875rem 1rem;border-radius:10px;margin-bottom:1.5rem;font-size:.875rem;font-weight:600">
  <svg style="flex-shrink:0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
  <span><%= flashError %></span>
  <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;cursor:pointer;color:#DC2626;font-size:1rem;line-height:1">✕</button>
</div>
<% } %>
<script>
  setTimeout(()=>{['flash-s','flash-e'].forEach(id=>{const el=document.getElementById(id);if(el){el.style.transition='opacity .4s';el.style.opacity='0';setTimeout(()=>el.remove(),400)}})},5000);
</script>
