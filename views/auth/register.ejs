<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div style="flex:1;display:flex;align-items:center;justify-content:center;padding:2.5rem 1rem;background:var(--bg)">
  <div style="width:100%;max-width:420px">

    <div style="text-align:center;margin-bottom:2rem">
      <div style="width:3.25rem;height:3.25rem;background:var(--green-light);border-radius:13px;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;border:1.5px solid rgba(42,168,101,.2)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--green-dark)" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
      </div>
      <h1 style="font-size:1.625rem;font-weight:800;color:var(--dark)">Crear cuenta</h1>
      <p style="font-size:.875rem;color:var(--gray);margin-top:.375rem">Necesitas una clave de acceso para registrarte</p>
    </div>

    <div class="card" style="padding:2rem">
      <%- include('../partials/flash') %>
      <form action="/auth/register" method="POST" style="display:flex;flex-direction:column;gap:1.25rem">
        <div>
          <label class="label" for="reg-email">Correo electrónico</label>
          <input id="reg-email" type="email" name="email" required autocomplete="email" placeholder="tu@correo.com" class="input" />
        </div>
        <div>
          <label class="label" for="reg-pwd">
            Contraseña
            <span style="font-weight:400;color:var(--gray)">&nbsp;(mínimo 8 caracteres)</span>
          </label>
          <input id="reg-pwd" type="password" name="password" required minlength="8" placeholder="Introduce tu contraseña" class="input" />
        </div>
        <div>
          <label class="label" for="reg-key">Clave de acceso</label>
          <input id="reg-key" type="text" name="access_key" required placeholder="CAT-XXXX-XXXX" class="input" style="text-transform:uppercase;letter-spacing:.1em" />
        </div>
        <button type="submit" class="btn btn-secondary" style="width:100%;padding:.8rem;font-size:.9375rem;margin-top:.25rem">
          Crear mi cuenta
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </form>

      <div style="margin-top:1.5rem;text-align:center">
        <p style="font-size:.8125rem;color:var(--gray);margin-bottom:.75rem">¿No tienes clave de acceso?</p>
        <button id="requestKeyBtn" type="button" class="btn btn-ghost btn-sm" style="width:100%;border:1.5px dashed var(--blue);color:var(--blue)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:.375rem">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
          Solicitar clave de acceso
        </button>
      </div>

      <div style="margin-top:1.25rem;padding:.875rem;background:var(--blue-light);border-radius:9px;border:1px solid rgba(46,95,168,.15);display:flex;align-items:flex-start;gap:.625rem">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2" style="flex-shrink:0;margin-top:.1rem"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p style="font-size:.78rem;color:var(--blue-dark);line-height:1.5">Sin clave de acceso, contacta al administrador de la plataforma.</p>
      </div>

      <div style="margin-top:1.25rem;text-align:center">
        <p style="font-size:.875rem;color:var(--gray)">
          ¿Ya tienes cuenta? <a href="/auth/login" class="link">Iniciar sesión</a>
        </p>
      </div>
    </div>

  </div>
</div>

<!-- Modal para solicitar clave -->
<div id="requestKeyModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;align-items:center;justify-content:center;padding:1.5rem">
  <div style="background:var(--white);border-radius:16px;max-width:450px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.3);position:relative">
    <button id="closeModalBtn" style="position:absolute;top:1rem;right:1rem;width:2rem;height:2rem;border-radius:50%;border:1.5px solid var(--border);background:var(--white);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--tr)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gray)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <div style="padding:2rem">
      <div style="text-align:center;margin-bottom:1.5rem">
        <div style="width:3rem;height:3rem;background:var(--blue-light);border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
        </div>
        <h2 style="font-size:1.25rem;font-weight:800;color:var(--dark);margin-bottom:.5rem">Solicitar Clave de Acceso</h2>
        <p style="font-size:.8125rem;color:var(--gray);line-height:1.5">Completa el formulario y envía tu solicitud por WhatsApp</p>
      </div>

      <form id="requestKeyForm" style="display:flex;flex-direction:column;gap:1.25rem">
        <div>
          <label class="label" for="rq-name">Nombre del Emprendimiento <span style="color:#DC2626">*</span></label>
          <input id="rq-name" type="text" required placeholder="Ej: Cafetería Central" class="input" />
        </div>
        <div>
          <label class="label" for="rq-desc">Descripción <span style="color:#DC2626">*</span></label>
          <textarea id="rq-desc" required rows="3" placeholder="Describe brevemente tu negocio..." class="input"></textarea>
        </div>
        <button type="submit" class="btn btn-secondary" style="width:100%;padding:.875rem;font-size:.9375rem;display:flex;align-items:center;justify-content:center;gap:.5rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.534 5.858L0 24l6.335-1.524A11.935 11.935 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.8 9.8 0 01-5.012-1.375l-.36-.214-3.732.897.934-3.63-.236-.374A9.755 9.755 0 012.182 12c0-5.413 4.405-9.818 9.818-9.818 5.413 0 9.818 4.405 9.818 9.818 0 5.413-4.405 9.818-9.818 9.818z"/>
          </svg>
          Enviar Solicitud por WhatsApp
        </button>
      </form>

      <div style="margin-top:1.25rem;padding:1rem;background:var(--bg);border-radius:9px;text-align:center">
        <p style="font-size:.75rem;color:var(--gray);line-height:1.6">
          📞 Se abrirá WhatsApp con tu solicitud pre-completada para enviar al administrador.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
// Modal para solicitar clave de acceso
document.addEventListener('DOMContentLoaded', function() {
  const requestKeyBtn = document.getElementById('requestKeyBtn');
  const requestKeyModal = document.getElementById('requestKeyModal');
  const closeModalBtn = document.getElementById('closeModalBtn');
  const requestKeyForm = document.getElementById('requestKeyForm');

  // Abrir modal
  if (requestKeyBtn) {
    requestKeyBtn.addEventListener('click', function() {
      requestKeyModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    });
  }

  // Cerrar modal
  function closeModal() {
    requestKeyModal.style.display = 'none';
    document.body.style.overflow = '';
  }

  if (closeModalBtn) {
    closeModalBtn.addEventListener('click', closeModal);
  }

  // Cerrar al hacer click fuera
  requestKeyModal.addEventListener('click', function(e) {
    if (e.target === requestKeyModal) {
      closeModal();
    }
  });

  // Cerrar con Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && requestKeyModal.style.display === 'flex') {
      closeModal();
    }
  });

  // Enviar formulario por WhatsApp
  if (requestKeyForm) {
    requestKeyForm.addEventListener('submit', function(e) {
      e.preventDefault();

      const businessName = document.getElementById('rq-name').value.trim();
      const description = document.getElementById('rq-desc').value.trim();

      if (!businessName || !description) {
        alert('Por favor completa todos los campos');
        return;
      }

      // Mensaje para WhatsApp
      const message = `Hola! 👋 Quiero solicitar una clave de acceso para DevisiStore.\n\n📌 *Nombre del emprendimiento:* ${businessName}\n📝 *Descripción:* ${description}\n\n¡Gracias!`;
      const encodedMessage = encodeURIComponent(message);

      // Número de WhatsApp del administrador
      const whatsappNumber = '5355847601';

      // Abrir WhatsApp
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;
      window.open(whatsappUrl, '_blank');

      // Cerrar modal después de enviar
      setTimeout(() => {
        closeModal();
        requestKeyForm.reset();
      }, 1000);
    });
  }
});
</script>

<%- include('../partials/footer') %>
</body>
</html>
