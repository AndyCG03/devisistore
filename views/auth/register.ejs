<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="min-h-screen bg-gradient-to-br from-brand-50 to-blue-50 flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8">
      <div class="text-center mb-8">
        <div class="w-12 h-12 bg-yellow-400 rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-gray-900" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Crear cuenta</h1>
        <p class="text-gray-500 text-sm mt-1">Necesitas una clave de acceso para registrarte</p>
      </div>

      <%- include('../partials/flash') %>

      <form action="/auth/register" method="POST" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" name="email" required autocomplete="email"
                 placeholder="tu@email.com"
                 class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>
          <input type="password" name="password" required minlength="8"
                 placeholder="Mínimo 8 caracteres"
                 class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Clave de acceso
            <span class="text-xs text-gray-400 ml-1">(ej: CAT-XXXX-XXXX)</span>
          </label>
          <input type="text" name="access_key" required
                 placeholder="CAT-XXXX-XXXX"
                 class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition uppercase tracking-widest" />
        </div>

        <button type="submit"
                class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 rounded-xl transition text-sm shadow">
          Crear mi cuenta →
        </button>
      </form>

      <div class="mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-xl">
        <p class="text-xs text-yellow-800 text-center">
          🔑 ¿No tienes clave de acceso? Contacta al administrador de la plataforma.
        </p>
      </div>

      <p class="text-center text-sm text-gray-500 mt-4">
        ¿Ya tienes cuenta?
        <a href="/auth/login" class="text-brand-600 font-semibold hover:underline">Iniciar sesión</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
</body>
</html>
