<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="page-wrap">
  <% locals.activePage = 'products'; %>
  <%- include('../partials/sidebar') %>

  <main class="page-main">
    <div style="max-width:640px">
      <a href="/dashboard/products" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Volver a productos
      </a>
      <h1 class="section-title" style="margin-bottom:.25rem"><%=title%></h1>
      <p class="section-sub" style="margin-bottom:1.75rem"><%=product?'Modifica los datos del producto.':'Añade un producto a tu catálogo.'%></p>

      <%- include('../partials/flash') %>

      <form action="<%=action%>" method="POST" enctype="multipart/form-data" class="card" style="padding:2rem;display:flex;flex-direction:column;gap:1.375rem">

        <div>
          <label class="label" for="p-name">Nombre <span style="color:#DC2626">*</span></label>
          <input id="p-name" type="text" name="name" required value="<%=product?product.name:''%>" placeholder="Ej: Café Americano" class="input" />
        </div>

        <div>
          <label class="label" for="p-desc">Descripción</label>
          <textarea id="p-desc" name="description" rows="3" placeholder="Descripción breve del producto..." class="input"><%=product?product.description:''%></textarea>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem">
          <div>
            <label class="label" for="p-price">Precio <span style="color:#DC2626">*</span></label>
            <input id="p-price" type="number" name="price" step="0.01" min="0" required value="<%=product?product.price:''%>" placeholder="0.00" class="input" />
          </div>
          <div>
            <label class="label" for="p-currency">Moneda</label>
            <select id="p-currency" name="currency" class="input">
              <option value="USD" <%=!product||product.currency==='USD'?'selected':''%>>USD ($)</option>
              <option value="CUP" <%=product&&product.currency==='CUP'?'selected':''%>>CUP ($)</option>
            </select>
          </div>
          <div>
            <label class="label" for="p-cat">Categoría</label>
            <input id="p-cat" type="text" name="category" value="<%=product?product.category:''%>" list="cat-list" placeholder="Ej: Bebidas" class="input" />
            <datalist id="cat-list"><% categories.forEach(c=>{%><option value="<%=c%>"><% }) %></datalist>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div>
            <label class="label" for="p-status">Estado</label>
            <select id="p-status" name="status" class="input">
              <option value="available" <%=!product||product.status==='available'?'selected':''%>>Disponible</option>
              <option value="unavailable" <%=product&&product.status==='unavailable'?'selected':''%>>Agotado</option>
            </select>
          </div>
          <div>
            <label class="label" for="p-stock">Disponibilidad</label>
            <select id="p-stock" name="stock_level" class="input">
              <option value="normal" <%=!product||product.stock_level==='normal'?'selected':''%>>Normal</option>
              <option value="low" <%=product&&product.stock_level==='low'?'selected':''%>>Pocas disponibles</option>
            </select>
          </div>
        </div>

        <div>
          <label class="label">Mostrar precio en el catálogo</label>
          <div style="display:flex;align-items:center;gap:.75rem">
            <label style="position:relative;display:inline-block;width:48px;height:26px;cursor:pointer">
              <input type="checkbox" id="showPriceToggle" name="show_price" value="1" <%=!product||product.show_price!==0?'checked':''%> style="opacity:0;width:0;height:0" />
              <span class="price-toggle-slider" style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:<%=!product||product.show_price!==0?'var(--green)':'var(--gray)'%>;border-radius:26px;transition:var(--tr)"></span>
              <span class="price-toggle-knob" style="position:absolute;height:20px;width:20px;left:3px;bottom:3px;background:white;border-radius:50%;transition:var(--tr);transform:<%=!product||product.show_price!==0?'translateX(22px)':'translateX(0)'%>"></span>
            </label>
            <span style="font-size:.8125rem;color:var(--gray)">El precio será visible para los clientes</span>
          </div>
          <p style="font-size:.75rem;color:var(--gray);margin-top:.375rem">Desactiva esta opción si prefieres que los clientes contacten por WhatsApp para consultar el precio</p>
        </div>

        <div>
          <label class="label">Imagen del producto</label>
          <% if(product && product.image){ %>
          <div style="margin-bottom:.875rem;display:flex;align-items:center;gap:.875rem">
            <img src="<%=product.image%>" alt="" style="width:4.5rem;height:4.5rem;object-fit:cover;border-radius:9px;border:1px solid var(--border)" />
            <p style="font-size:.78rem;color:var(--gray)">Imagen actual. Sube otra para reemplazarla.</p>
          </div>
          <% } %>
          
          <!-- Previsualización -->
          <div id="imagePreview" style="display:none;margin-bottom:1rem">
            <img id="previewImg" src="" alt="Previsualización" style="width:150px;height:150px;object-fit:cover;border-radius:12px;border:2px solid var(--border);box-shadow:0 2px 8px rgba(0,0,0,.08)" />
            <p style="font-size:.75rem;color:var(--gray);margin-top:.5rem">Tamaño estimado: <span id="imageSize">-</span> KB</p>
          </div>
          
          <input type="file" id="imageInput" name="image" accept="image/*" style="display:none" />
          <button type="button" id="selectImageBtn" class="btn btn-ghost btn-sm" style="width:100%;border:1.5px dashed var(--border);padding:1.25rem">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--gray)" stroke-width="2" style="margin-bottom:.5rem">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span style="color:var(--gray)">Seleccionar imagen</span>
          </button>
          <p style="font-size:.75rem;color:var(--gray);margin-top:.5rem">JPG, PNG o WEBP. Máximo 500 KB (se comprime automáticamente)</p>
        </div>

        <div style="display:flex;gap:.75rem;padding-top:.5rem;border-top:1px solid var(--border);flex-wrap:wrap">
          <button type="submit" class="btn btn-primary">
            <%=product?'Guardar cambios':'Crear producto'%>
          </button>
          <a href="/dashboard/products" class="btn btn-ghost">Cancelar</a>
        </div>

      </form>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

<script>
// Previsualización y compresión de imagen
document.addEventListener('DOMContentLoaded', function() {
  const selectImageBtn = document.getElementById('selectImageBtn');
  const imageInput = document.getElementById('imageInput');
  const imagePreview = document.getElementById('imagePreview');
  const previewImg = document.getElementById('previewImg');
  const imageSize = document.getElementById('imageSize');

  // Click en botón abre selector de archivos
  if (selectImageBtn) {
    selectImageBtn.addEventListener('click', function() {
      imageInput.click();
    });
  }

  // Previsualizar y comprimir imagen seleccionada
  if (imageInput) {
    imageInput.addEventListener('change', async function(e) {
      const file = e.target.files[0];
      if (!file) return;

      // Validar tipo
      if (!file.type.startsWith('image/')) {
        alert('Por favor selecciona un archivo de imagen válido');
        return;
      }

      // Leer y comprimir imagen
      try {
        const compressedFile = await compressImage(file, 800, 800, 0.7);
        
        // Mostrar previsualización
        const reader = new FileReader();
        reader.onload = function(event) {
          previewImg.src = event.target.result;
          imagePreview.style.display = 'block';
          imageSize.textContent = Math.round(compressedFile.size / 1024);
          
          // Actualizar botón
          selectImageBtn.innerHTML = `
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" style="margin-bottom:.5rem">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span style="color:var(--green)">Imagen seleccionada</span>
          `;
          selectImageBtn.style.borderColor = 'var(--green)';
          selectImageBtn.style.background = 'var(--green-light)';
        };
        reader.readAsDataURL(compressedFile);
        
        // Reemplazar el archivo en el input
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(compressedFile);
        imageInput.files = dataTransfer.files;
        
      } catch (err) {
        console.error('Error al procesar imagen:', err);
        alert('Error al procesar la imagen. Intenta con otra.');
      }
    });
  }
});

// Función para comprimir imagen usando canvas
async function compressImage(file, maxWidth, maxHeight, quality) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    
    reader.onload = function(event) {
      const img = new Image();
      
      img.onload = function() {
        // Calcular dimensiones
        let width = img.width;
        let height = img.height;
        
        // Escalar si es más grande que el máximo
        if (width > maxWidth) {
          height = (maxWidth / width) * height;
          width = maxWidth;
        }
        if (height > maxHeight) {
          width = (maxHeight / height) * width;
          height = maxHeight;
        }
        
        // Crear canvas
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);
        
        // Convertir a blob comprimida
        canvas.toBlob(
          function(blob) {
            if (blob) {
              // Crear archivo con nombre original
              const compressedFile = new File([blob], file.name, {
                type: 'image/jpeg',
                lastModified: Date.now()
              });
              resolve(compressedFile);
            } else {
              reject(new Error('Error al comprimir imagen'));
            }
          },
          'image/jpeg',
          quality
        );
      };
      
      img.onerror = function() {
        reject(new Error('Error al cargar imagen'));
      };
      
      img.src = event.target.result;
    };
    
    reader.onerror = function() {
      reject(new Error('Error al leer archivo'));
    };
    
    reader.readAsDataURL(file);
  });
}

// Toggle switch para mostrar precio
const showPriceToggle = document.getElementById('showPriceToggle');
if (showPriceToggle) {
  showPriceToggle.addEventListener('change', function() {
    const slider = this.parentElement.querySelector('.price-toggle-slider');
    const knob = this.parentElement.querySelector('.price-toggle-knob');
    
    if (this.checked) {
      slider.style.background = 'var(--green)';
      knob.style.transform = 'translateX(22px)';
    } else {
      slider.style.background = 'var(--gray)';
      knob.style.transform = 'translateX(0)';
    }
  });
}
</script>

</body>
</html>
