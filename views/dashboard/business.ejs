<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="page-wrap">
  <% locals.activePage = 'business'; %>
  <%- include('../partials/sidebar') %>

  <main class="page-main">
    <div style="max-width:700px">

      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem">
        <div>
          <h1 class="section-title"><%=business?'Editar Negocio':'Crear Negocio'%></h1>
          <p class="section-sub">Información pública visible en tu catálogo.</p>
        </div>
        <% if(business){ %>
          <a href="/shop/<%=business.slug%>" target="_blank" class="btn btn-ghost btn-sm">Ver catálogo</a>
        <% } %>
      </div>

      <%- include('../partials/flash') %>

      <form action="/dashboard/business" method="POST" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:1.5rem">

        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.8rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.09em">Información básica</h2>
          <div>
            <label class="label" for="b-name">Nombre del negocio <span style="color:#DC2626">*</span></label>
            <input id="b-name" type="text" name="name" required value="<%=business?business.name:''%>" placeholder="Ej: Cafetería Central" class="input" />
          </div>
          <div>
            <label class="label">Logo del negocio</label>
            
            <!-- Previsualización -->
            <div id="logoPreview" style="display:none;margin-bottom:1rem">
              <img id="previewImg" src="" alt="Previsualización" style="width:100px;height:100px;object-fit:cover;border-radius:12px;border:2px solid var(--border);box-shadow:0 2px 8px rgba(0,0,0,.08)" />
              <p style="font-size:.75rem;color:var(--gray);margin-top:.5rem">Tamaño: <span id="logoSize">-</span> KB</p>
            </div>
            
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
              <% if(business&&business.logo){ %>
                <img id="currentLogo" src="<%=business.logo%>" alt="Logo actual" style="width:4rem;height:4rem;object-fit:cover;border-radius:9px;border:1px solid var(--border)" />
                <p style="font-size:.78rem;color:var(--gray)">Logo actual. Sube otro para reemplazarlo.</p>
              <% } %>
            </div>
            
            <input type="file" id="logoInput" name="logo" accept="image/*" style="display:none" />
            <button type="button" id="selectLogoBtn" class="btn btn-ghost btn-sm" style="width:100%;border:1.5px dashed var(--border);padding:1.25rem;margin-top:.75rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--gray)" stroke-width="2" style="margin-bottom:.5rem">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span style="color:var(--gray)">Seleccionar logo</span>
            </button>
            <p style="font-size:.75rem;color:var(--gray);margin-top:.5rem">PNG, JPG o WEBP. Se recomienda imagen cuadrada.</p>
          </div>
          <div>
            <label class="label" for="b-desc">Descripción</label>
            <textarea id="b-desc" name="description" rows="3" placeholder="Describe tu negocio brevemente..." class="input"><%=business?business.description:''%></textarea>
          </div>
          <div>
            <label class="label" for="b-color">Color del header</label>
            <div style="display:flex;align-items:center;gap:.75rem">
              <input id="b-color" type="color" name="header_color" value="<%=business&&business.header_color?business.header_color:'#2E5FA8'%>" style="width:3rem;height:2.5rem;border:none;border-radius:6px;cursor:pointer;background:none" />
              <input type="text" value="<%=business&&business.header_color?business.header_color:'#2E5FA8'%>" readonly style="flex:1;max-width:120px;padding:.5rem;border:1.5px solid var(--border);border-radius:8px;font-family:monospace;font-size:.8125rem;color:var(--gray);background:var(--bg)" />
            </div>
            <p style="font-size:.75rem;color:var(--gray);margin-top:.375rem">Elige el color principal de tu catálogo. Por defecto: Azul (#2E5FA8)</p>
          </div>
          <div>
            <label class="label" for="b-sched">Horario de atención</label>
            <input id="b-sched" type="text" name="schedule" value="<%=business?business.schedule:''%>" placeholder="Ej: Lun-Vie 9:00 am – 6:00 pm" class="input" />
          </div>
        </div>

        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.8rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.09em">Información de contacto</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
            <div>
              <label class="label" for="b-addr">Dirección</label>
              <input id="b-addr" type="text" name="address" value="<%=business?business.address:''%>" class="input" />
            </div>
            <div>
              <label class="label" for="b-phone">Teléfono</label>
              <input id="b-phone" type="text" name="phone" value="<%=business?business.phone:''%>" class="input" />
            </div>
            <div>
              <label class="label" for="b-wa">WhatsApp <span style="color:var(--gray);font-weight:400">(con código de país)</span></label>
              <input id="b-wa" type="text" name="whatsapp" value="<%=business?business.whatsapp:''%>" placeholder="5215512345678" class="input" />
            </div>
            <div>
              <label class="label" for="b-email">Email de contacto</label>
              <input id="b-email" type="email" name="email" value="<%=business?business.email:''%>" class="input" />
            </div>
          </div>
        </div>

        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.8rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.09em">Redes sociales</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem">
            <% ['instagram','facebook','twitter','tiktok'].forEach(n=>{ %>
            <div>
              <label class="label" for="b-<%=n%>" style="text-transform:capitalize"><%=n%></label>
              <input id="b-<%=n%>" type="text" name="<%=n%>" value="<%=socials[n]||''%>" placeholder="@usuario" class="input" />
            </div>
            <% }) %>
          </div>
        </div>

        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
          <button type="submit" class="btn btn-primary"><%=business?'Guardar cambios':'Crear negocio'%></button>
          <a href="/dashboard" class="btn btn-ghost">Cancelar</a>
        </div>

      </form>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

<script>
// Previsualización de logo (sin compresión)
document.addEventListener('DOMContentLoaded', function() {
  const selectLogoBtn = document.getElementById('selectLogoBtn');
  const logoInput = document.getElementById('logoInput');
  const logoPreview = document.getElementById('logoPreview');
  const previewImg = document.getElementById('previewImg');
  const logoSize = document.getElementById('logoSize');
  const currentLogo = document.getElementById('currentLogo');

  // Click en botón abre selector de archivos
  if (selectLogoBtn) {
    selectLogoBtn.addEventListener('click', function() {
      logoInput.click();
    });
  }

  // Previsualizar logo seleccionado
  if (logoInput) {
    logoInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;

      // Validar tipo
      if (!file.type.startsWith('image/')) {
        alert('Por favor selecciona un archivo de imagen válido');
        return;
      }

      // Mostrar previsualización
      const reader = new FileReader();
      reader.onload = function(event) {
        previewImg.src = event.target.result;
        logoPreview.style.display = 'block';
        logoSize.textContent = Math.round(file.size / 1024);
        
        // Ocultar logo actual si existe
        if (currentLogo) {
          currentLogo.style.display = 'none';
          currentLogo.nextElementSibling.style.display = 'none';
        }
        
        // Actualizar botón
        selectLogoBtn.innerHTML = `
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" style="margin-bottom:.5rem">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          <span style="color:var(--green)">Logo seleccionado</span>
        `;
        selectLogoBtn.style.borderColor = 'var(--green)';
        selectLogoBtn.style.background = 'var(--green-light)';
      };
      reader.readAsDataURL(file);
    });
  }
});
</script>

</body>
</html>
