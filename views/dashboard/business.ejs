<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div style="display:flex;min-height:calc(100vh - 3.75rem)">
  <% locals.activePage = 'business'; %>
  <%- include('../partials/sidebar') %>

  <main style="flex:1;padding:2rem 2.5rem">
    <div style="max-width:720px">

      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem">
        <div>
          <h1 class="section-title"><%=business?'Editar Negocio':'Crear Negocio'%></h1>
          <p class="section-sub">Tu información pública visible en el catálogo.</p>
        </div>
        <% if(business){ %>
          <a href="/shop/<%=business.slug%>" target="_blank" class="btn-ghost btn-sm">Ver catálogo →</a>
        <% } %>
      </div>

      <%- include('../partials/flash') %>

      <form action="/dashboard/business" method="POST" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:1.5rem">

        <!-- Info básica -->
        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.875rem;font-weight:700;color:var(--dark);text-transform:uppercase;letter-spacing:.07em">Información básica</h2>
          <div>
            <label class="label">Nombre del negocio <span style="color:#DC2626">*</span></label>
            <input type="text" name="name" required value="<%=business?business.name:''%>" placeholder="Ej: Cafetería Central" class="input" />
          </div>
          <div>
            <label class="label">Logo del negocio</label>
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
              <% if(business&&business.logo){ %>
                <img src="<%=business.logo%>" alt="Logo" style="width:4rem;height:4rem;object-fit:cover;border-radius:9px;border:1px solid var(--border)" />
              <% } %>
              <input type="file" name="logo" accept="image/*" style="font-size:.875rem;color:var(--gray);font-family:'Exo 2',sans-serif" />
            </div>
          </div>
          <div>
            <label class="label">Descripción</label>
            <textarea name="description" rows="3" placeholder="Describe tu negocio brevemente…" class="input"><%=business?business.description:''%></textarea>
          </div>
          <div>
            <label class="label">Horario de atención</label>
            <input type="text" name="schedule" value="<%=business?business.schedule:''%>" placeholder="Ej: Lun-Vie 9:00 am – 6:00 pm" class="input" />
          </div>
        </div>

        <!-- Contacto -->
        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.875rem;font-weight:700;color:var(--dark);text-transform:uppercase;letter-spacing:.07em">Contacto</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem">
            <div><label class="label">Dirección</label><input type="text" name="address" value="<%=business?business.address:''%>" class="input" /></div>
            <div><label class="label">Teléfono</label><input type="text" name="phone" value="<%=business?business.phone:''%>" class="input" /></div>
            <div>
              <label class="label">WhatsApp <span style="color:var(--gray);font-weight:400">(con código de país)</span></label>
              <input type="text" name="whatsapp" value="<%=business?business.whatsapp:''%>" placeholder="5215512345678" class="input" />
            </div>
            <div><label class="label">Email de contacto</label><input type="email" name="email" value="<%=business?business.email:''%>" class="input" /></div>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.875rem;font-weight:700;color:var(--dark);text-transform:uppercase;letter-spacing:.07em">Redes sociales</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
            <% ['instagram','facebook','twitter','tiktok'].forEach(n=>{ %>
            <div>
              <label class="label" style="text-transform:capitalize"><%=n%></label>
              <input type="text" name="<%=n%>" value="<%=socials[n]||''%>" placeholder="@usuario" class="input" />
            </div>
            <% }) %>
          </div>
        </div>

        <div style="display:flex;gap:.75rem">
          <button type="submit" class="btn-primary"><%=business?'Guardar cambios':'Crear negocio'%></button>
          <a href="/dashboard" class="btn-ghost">Cancelar</a>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
</body>
</html>
