<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="flex min-h-screen">
  <% locals.activePage = 'business'; %>
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-6 md:p-10">
    <div class="max-w-3xl">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900"><%= business ? 'Editar Negocio' : 'Crear Negocio' %></h1>
          <p class="text-gray-500 mt-1">Tu información pública en el catálogo.</p>
        </div>
        <% if (business) { %>
          <a href="/shop/<%= business.slug %>" target="_blank"
             class="text-sm bg-brand-50 text-brand-700 border border-brand-200 px-4 py-2 rounded-xl hover:bg-brand-100 transition">
            Ver catálogo →
          </a>
        <% } %>
      </div>

      <%- include('../partials/flash') %>

      <form action="/dashboard/business" method="POST" enctype="multipart/form-data" class="space-y-8">

        <!-- Información básica -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">
          <h2 class="font-semibold text-gray-900 border-b border-gray-100 pb-3">Información básica</h2>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del negocio <span class="text-red-500">*</span></label>
            <input type="text" name="name" required value="<%= business ? business.name : '' %>"
                   placeholder="Ej: Cafetería Central"
                   class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Logo del negocio</label>
            <div class="flex items-center gap-4">
              <% if (business && business.logo) { %>
                <img src="<%= business.logo %>" alt="Logo" class="w-16 h-16 object-cover rounded-xl border border-gray-200" />
              <% } %>
              <input type="file" name="logo" accept="image/*"
                     class="text-sm text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0
                            file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea name="description" rows="3"
                      placeholder="Describe tu negocio brevemente..."
                      class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none transition resize-none"><%= business ? business.description : '' %></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Horario de atención</label>
            <input type="text" name="schedule" value="<%= business ? business.schedule : '' %>"
                   placeholder="Ej: Lun-Vie 9:00 am – 6:00 pm"
                   class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none transition" />
          </div>
        </div>

        <!-- Contacto -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">
          <h2 class="font-semibold text-gray-900 border-b border-gray-100 pb-3">Contacto</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Dirección</label>
              <input type="text" name="address" value="<%= business ? business.address : '' %>"
                     class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none transition" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
              <input type="text" name="phone" value="<%= business ? business.phone : '' %>"
                     class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none transition" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp (con código de país)</label>
              <input type="text" name="whatsapp" value="<%= business ? business.whatsapp : '' %>"
                     placeholder="5215512345678"
                     class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none transition" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Email de contacto</label>
              <input type="email" name="email" value="<%= business ? business.email : '' %>"
                     class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none transition" />
            </div>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4">
          <h2 class="font-semibold text-gray-900 border-b border-gray-100 pb-3">Redes sociales</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            <% const nets = ['instagram','facebook','twitter','tiktok']; %>
            <% nets.forEach(n => { %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1 capitalize"><%= n %></label>
              <input type="text" name="<%= n %>" value="<%= socials[n] || '' %>"
                     placeholder="@usuario"
                     class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 outline-none transition" />
            </div>
            <% }) %>
          </div>
        </div>

        <div class="flex gap-3">
          <button type="submit"
                  class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-8 py-3 rounded-xl transition shadow">
            <%= business ? 'Guardar cambios' : 'Crear negocio' %>
          </button>
          <a href="/dashboard" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-6 py-3 rounded-xl transition">
            Cancelar
          </a>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
</body>
</html>
