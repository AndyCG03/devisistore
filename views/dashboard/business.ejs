<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="page-wrap">
  <% locals.activePage = 'business'; %>
  <%- include('../partials/sidebar') %>

  <main class="page-main">
    <div style="max-width:700px">

      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem">
        <div>
          <h1 class="section-title"><%=business?'Editar Negocio':'Crear Negocio'%></h1>
          <p class="section-sub">Información pública visible en tu catálogo.</p>
        </div>
        <% if(business){ %>
          <a href="/shop/<%=business.slug%>" target="_blank" class="btn btn-ghost btn-sm">Ver catálogo</a>
        <% } %>
      </div>

      <%- include('../partials/flash') %>

      <form action="/dashboard/business" method="POST" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:1.5rem">

        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.8rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.09em">Información básica</h2>
          <div>
            <label class="label" for="b-name">Nombre del negocio <span style="color:#DC2626">*</span></label>
            <input id="b-name" type="text" name="name" required value="<%=business?business.name:''%>" placeholder="Ej: Cafetería Central" class="input" />
          </div>
          <div>
            <label class="label">Logo del negocio</label>
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
              <% if(business&&business.logo){ %>
                <img src="<%=business.logo%>" alt="Logo" style="width:4rem;height:4rem;object-fit:cover;border-radius:9px;border:1px solid var(--border)" />
              <% } %>
              <input type="file" name="logo" accept="image/*" style="font-size:.875rem;color:var(--gray);font-family:'Exo 2',sans-serif" />
            </div>
          </div>
          <div>
            <label class="label" for="b-desc">Descripción</label>
            <textarea id="b-desc" name="description" rows="3" placeholder="Describe tu negocio brevemente..." class="input"><%=business?business.description:''%></textarea>
          </div>
          <div>
            <label class="label" for="b-sched">Horario de atención</label>
            <input id="b-sched" type="text" name="schedule" value="<%=business?business.schedule:''%>" placeholder="Ej: Lun-Vie 9:00 am – 6:00 pm" class="input" />
          </div>
        </div>

        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.8rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.09em">Información de contacto</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem">
            <div>
              <label class="label" for="b-addr">Dirección</label>
              <input id="b-addr" type="text" name="address" value="<%=business?business.address:''%>" class="input" />
            </div>
            <div>
              <label class="label" for="b-phone">Teléfono</label>
              <input id="b-phone" type="text" name="phone" value="<%=business?business.phone:''%>" class="input" />
            </div>
            <div>
              <label class="label" for="b-wa">WhatsApp <span style="color:var(--gray);font-weight:400">(con código de país)</span></label>
              <input id="b-wa" type="text" name="whatsapp" value="<%=business?business.whatsapp:''%>" placeholder="5215512345678" class="input" />
            </div>
            <div>
              <label class="label" for="b-email">Email de contacto</label>
              <input id="b-email" type="email" name="email" value="<%=business?business.email:''%>" class="input" />
            </div>
          </div>
        </div>

        <div class="card" style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem">
          <h2 style="font-size:.8rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.09em">Redes sociales</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem">
            <% ['instagram','facebook','twitter','tiktok'].forEach(n=>{ %>
            <div>
              <label class="label" for="b-<%=n%>" style="text-transform:capitalize"><%=n%></label>
              <input id="b-<%=n%>" type="text" name="<%=n%>" value="<%=socials[n]||''%>" placeholder="@usuario" class="input" />
            </div>
            <% }) %>
          </div>
        </div>

        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
          <button type="submit" class="btn btn-primary"><%=business?'Guardar cambios':'Crear negocio'%></button>
          <a href="/dashboard" class="btn btn-ghost">Cancelar</a>
        </div>

      </form>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
</body>
</html>
