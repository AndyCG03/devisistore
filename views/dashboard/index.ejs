<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="page-wrap">
  <% locals.activePage = 'home'; %>
  <%- include('../partials/sidebar') %>

  <main class="page-main">
    <div style="margin-bottom:2rem">
      <h1 class="section-title">Bienvenido, <span style="color:var(--blue)"><%= user.email.split('@')[0] %></span></h1>
      <p class="section-sub">Resumen de tu actividad en DevisiStore.</p>
    </div>

    <%- include('../partials/flash') %>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.25rem;margin-bottom:2.5rem">

      <div class="card" style="padding:1.5rem;border-left:3px solid var(--blue)">
        <p style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray);margin-bottom:.5rem">Mi negocio</p>
        <p style="font-size:1.25rem;font-weight:800;color:var(--dark);line-height:1.3"><%= business ? business.name : 'Sin negocio' %></p>
        <% if(business){ %>
          <a href="/shop/<%= business.slug %>" target="_blank" class="link" style="font-size:.8rem;display:inline-block;margin-top:.5rem">Ver catálogo</a>
        <% } else { %>
          <a href="/dashboard/business" class="link" style="font-size:.8rem;color:var(--green);display:inline-block;margin-top:.5rem">Crear negocio</a>
        <% } %>
      </div>

      <div class="card" style="padding:1.5rem;border-left:3px solid var(--green)">
        <p style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray);margin-bottom:.5rem">Productos</p>
        <p style="font-size:2rem;font-weight:800;color:var(--dark)"><%= productCount %></p>
        <a href="/dashboard/products" class="link" style="font-size:.8rem;color:var(--green);display:inline-block;margin-top:.5rem">Gestionar</a>
      </div>

      <div class="card" style="padding:1.5rem;border-left:3px solid #D1D5DB">
        <p style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray);margin-bottom:.5rem">URL de tu catálogo</p>
        <% if(business){ %>
          <p id="catalogUrl" style="font-size:.78rem;font-family:monospace;color:var(--blue);word-break:break-all;margin-top:.25rem">/shop/<%= business.slug %></p>
          <button id="copyUrlBtn" class="btn btn-ghost btn-sm" style="margin-top:.625rem">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:.375rem">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="copyUrlText">Copiar enlace</span>
          </button>
        <% } else { %>
          <p style="font-size:.8rem;color:var(--gray);margin-top:.25rem">Crea tu negocio primero</p>
        <% } %>
      </div>

    </div>

    <!-- Quick actions -->
    <h2 style="font-size:1rem;font-weight:700;color:var(--dark);margin-bottom:1rem">Acciones rápidas</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem">

      <a href="/dashboard/business" class="card card-hover" style="padding:1.5rem;display:flex;align-items:center;gap:1rem;text-decoration:none">
        <div style="width:2.75rem;height:2.75rem;background:var(--blue-light);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <div>
          <p style="font-size:.9375rem;font-weight:700;color:var(--dark)"><%= business ? 'Editar negocio' : 'Crear negocio' %></p>
          <p style="font-size:.8rem;color:var(--gray);margin-top:.2rem">Logo, descripción, contacto y redes</p>
        </div>
      </a>

      <a href="/dashboard/products/new" class="card card-hover" style="padding:1.5rem;display:flex;align-items:center;gap:1rem;text-decoration:none">
        <div style="width:2.75rem;height:2.75rem;background:var(--green-light);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        </div>
        <div>
          <p style="font-size:.9375rem;font-weight:700;color:var(--dark)">Nuevo producto</p>
          <p style="font-size:.8rem;color:var(--gray);margin-top:.2rem">Sube foto, precio y descripción</p>
        </div>
      </a>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>

<script>
// Copiar URL del catálogo
document.addEventListener('DOMContentLoaded', function() {
  const copyUrlBtn = document.getElementById('copyUrlBtn');
  const catalogUrl = document.getElementById('catalogUrl');
  const copyUrlText = document.getElementById('copyUrlText');

  if (copyUrlBtn && catalogUrl) {
    copyUrlBtn.addEventListener('click', async function() {
      try {
        const fullUrl = window.location.origin + catalogUrl.textContent.trim();
        await navigator.clipboard.writeText(fullUrl);
        
        // Feedback visual
        const originalText = copyUrlText.textContent;
        copyUrlText.textContent = '¡Copiado!';
        copyUrlBtn.style.background = 'var(--green-light)';
        copyUrlBtn.style.color = 'var(--green-dark)';
        
        setTimeout(() => {
          copyUrlText.textContent = originalText;
          copyUrlBtn.style.background = '';
          copyUrlBtn.style.color = '';
        }, 2000);
      } catch (err) {
        console.error('Error al copiar:', err);
        copyUrlText.textContent = 'Error';
      }
    });
  }
});
</script>

</body>
</html>
