<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="flex min-h-screen">
  <% locals.activePage = 'home'; %>
  <%- include('../partials/sidebar') %>

  <main class="flex-1 p-6 md:p-10 max-w-5xl">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-gray-900">Bienvenido, <span class="text-brand-600"><%= user.email %></span></h1>
      <p class="text-gray-500 mt-1">Aquí tienes un resumen de tu actividad.</p>
    </div>

    <%- include('../partials/flash') %>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <p class="text-sm text-gray-500 mb-1">Negocio</p>
        <p class="text-2xl font-bold text-gray-900"><%= business ? business.name : '—' %></p>
        <% if (business) { %>
          <a href="/shop/<%= business.slug %>" target="_blank"
             class="text-xs text-brand-600 hover:underline mt-1 inline-block">Ver catálogo →</a>
        <% } else { %>
          <a href="/dashboard/business" class="text-xs text-yellow-600 hover:underline mt-1 inline-block">Crear negocio →</a>
        <% } %>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <p class="text-sm text-gray-500 mb-1">Productos cargados</p>
        <p class="text-2xl font-bold text-gray-900"><%= productCount %></p>
        <a href="/dashboard/products" class="text-xs text-brand-600 hover:underline mt-1 inline-block">Gestionar →</a>
      </div>

      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <p class="text-sm text-gray-500 mb-1">URL de tu catálogo</p>
        <% if (business) { %>
          <p class="text-sm font-mono text-brand-700 mt-1 break-all">/shop/<%= business.slug %></p>
          <button onclick="navigator.clipboard.writeText(window.location.origin+'/shop/<%= business.slug %>');this.textContent='¡Copiado!'"
                  class="text-xs bg-brand-50 text-brand-700 px-2 py-1 rounded mt-2 hover:bg-brand-100 transition">
            Copiar enlace
          </button>
        <% } else { %>
          <p class="text-sm text-gray-400 mt-1">Crea tu negocio primero</p>
        <% } %>
      </div>
    </div>

    <!-- Acciones rápidas -->
    <h2 class="text-lg font-bold text-gray-900 mb-4">Acciones rápidas</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      <a href="/dashboard/business"
         class="flex items-center gap-4 bg-white border border-gray-100 rounded-2xl p-5 shadow-sm hover:border-brand-300 hover:shadow-md transition card-hover">
        <div class="w-10 h-10 bg-brand-50 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-gray-900"><%= business ? 'Editar negocio' : 'Crear negocio' %></p>
          <p class="text-sm text-gray-500">Logo, descripción, contacto y redes</p>
        </div>
      </a>

      <a href="/dashboard/products/new"
         class="flex items-center gap-4 bg-white border border-gray-100 rounded-2xl p-5 shadow-sm hover:border-brand-300 hover:shadow-md transition card-hover">
        <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-gray-900">Nuevo producto</p>
          <p class="text-sm text-gray-500">Sube foto, precio y descripción</p>
        </div>
      </a>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
</body>
</html>
