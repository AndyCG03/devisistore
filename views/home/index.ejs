<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<!-- HERO -->
<section class="hero-gradient" style="padding:5rem 1.5rem 4rem">
  <div style="max-width:900px;margin:0 auto;text-align:center">
    <span style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.15);color:#fff;font-size:.8rem;font-weight:700;padding:.4rem 1rem;border-radius:99px;margin-bottom:1.75rem;border:1px solid rgba(255,255,255,.2);letter-spacing:.04em">
      🚀 &nbsp;CATÁLOGO DIGITAL PROFESIONAL
    </span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.75rem);font-weight:800;color:#fff;line-height:1.15;margin-bottom:1.25rem">
      Tu negocio, online<br/>
      <span style="color:#6EE7B7">en minutos</span>
    </h1>
    <p style="font-size:1.125rem;color:rgba(255,255,255,.8);max-width:560px;margin:0 auto 2.5rem;line-height:1.7">
      Crea tu catálogo digital, sube tus productos con fotos y comparte el enlace con tus clientes. Sin código. Sin diseñadores.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center">
      <a href="/auth/register" style="display:inline-flex;align-items:center;gap:.5rem;background:#2AA865;color:#fff;font-weight:700;font-size:1rem;padding:.85rem 2rem;border-radius:var(--r-btn);border:none;cursor:pointer;box-shadow:0 4px 16px rgba(42,168,101,.35);transition:var(--tr);text-decoration:none" onmouseover="this.style.background='#34BF76'" onmouseout="this.style.background='#2AA865'">
        Crear mi catálogo gratis →
      </a>
      <a href="#como-funciona" style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);color:#fff;font-weight:600;font-size:1rem;padding:.85rem 1.75rem;border-radius:var(--r-btn);border:1.5px solid rgba(255,255,255,.3);transition:var(--tr);text-decoration:none">
        Ver cómo funciona
      </a>
    </div>

    <!-- Stats strip -->
    <div style="display:flex;flex-wrap:wrap;gap:2.5rem;justify-content:center;margin-top:3.5rem;padding-top:2.5rem;border-top:1px solid rgba(255,255,255,.15)">
      <% [['Sin código','✓'],['Imágenes incluidas','✓'],['Botón WhatsApp','✓'],['URL pública','✓']].forEach(([t,i])=>{ %>
      <div style="display:flex;align-items:center;gap:.5rem;color:rgba(255,255,255,.9);font-size:.875rem;font-weight:600">
        <span style="color:#6EE7B7;font-size:1rem"><%=i%></span> <%=t%>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- STEPS -->
<section id="como-funciona" style="padding:5rem 1.5rem;background:var(--white)">
  <div style="max-width:1100px;margin:0 auto">
    <div style="text-align:center;margin-bottom:3.5rem">
      <h2 style="font-size:2rem;font-weight:800;color:var(--dark)">¿Cómo funciona?</h2>
      <p style="color:var(--gray);margin-top:.5rem;font-size:1rem">Tres pasos para tener tu catálogo online</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1.75rem">
      <% const steps=[
        {num:'01',icon:'🔑',title:'Obtén acceso',desc:'Solicita tu clave de acceso al administrador y crea tu cuenta en segundos.',color:'var(--blue-light)',border:'rgba(46,95,168,.2)'},
        {num:'02',icon:'🏪',title:'Crea tu negocio',desc:'Agrega logo, descripción, horario, contacto y redes sociales de tu negocio.',color:'var(--green-light)',border:'rgba(42,168,101,.2)'},
        {num:'03',icon:'📦',title:'Publica productos',desc:'Sube fotos, precios y categorías. Tu catálogo queda publicado de inmediato.',color:'var(--blue-light)',border:'rgba(46,95,168,.2)'},
      ]; steps.forEach(s=>{ %>
      <div style="background:var(--white);border-radius:var(--r-card);padding:2rem;border:1.5px solid <%=s.border%>;position:relative;overflow:hidden">
        <div style="position:absolute;top:1rem;right:1.25rem;font-size:3rem;font-weight:900;color:<%=s.color%>;line-height:1;font-family:'Exo 2',sans-serif"><%=s.num%></div>
        <div style="font-size:2.5rem;margin-bottom:1rem"><%=s.icon%></div>
        <h3 style="font-size:1.1rem;font-weight:700;color:var(--dark);margin-bottom:.5rem"><%=s.title%></h3>
        <p style="font-size:.875rem;color:var(--gray);line-height:1.7"><%=s.desc%></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section style="padding:5rem 1.5rem;background:var(--bg)">
  <div style="max-width:1100px;margin:0 auto">
    <div style="text-align:center;margin-bottom:3.5rem">
      <h2 style="font-size:2rem;font-weight:800;color:var(--dark)">Todo lo que necesitas</h2>
      <p style="color:var(--gray);margin-top:.5rem">Funcionalidades pensadas para pequeños negocios</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.25rem">
      <% const features=[
        {icon:'🌐',t:'URL pública única',d:'Cada negocio tiene su propio enlace para compartir.'},
        {icon:'💬',t:'Botón WhatsApp',d:'Tus clientes te contactan con un solo clic desde cada producto.'},
        {icon:'🔍',t:'Búsqueda y filtros',d:'Tus clientes encuentran lo que buscan al instante.'},
        {icon:'🖼️',t:'Galería de imágenes',d:'Sube fotos de alta calidad para cada producto.'},
        {icon:'📊',t:'Panel de control',d:'Gestiona todo desde un dashboard intuitivo y moderno.'},
        {icon:'🔒',t:'Acceso controlado',d:'Solo usuarios invitados pueden registrarse en la plataforma.'},
      ]; features.forEach(f=>{ %>
      <div class="card" style="padding:1.5rem;display:flex;gap:1rem;align-items:flex-start">
        <div style="width:2.5rem;height:2.5rem;background:var(--blue-light);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0"><%=f.icon%></div>
        <div>
          <h4 style="font-size:.9rem;font-weight:700;color:var(--dark);margin-bottom:.25rem"><%=f.t%></h4>
          <p style="font-size:.8rem;color:var(--gray);line-height:1.6"><%=f.d%></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- CTA -->
<section style="padding:5rem 1.5rem;background:var(--white);text-align:center">
  <div style="max-width:600px;margin:0 auto">
    <div style="width:4rem;height:4rem;background:var(--green-light);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 1.5rem">🚀</div>
    <h2 style="font-size:2rem;font-weight:800;color:var(--dark);margin-bottom:.75rem">¿Listo para empezar?</h2>
    <p style="color:var(--gray);margin-bottom:2rem;line-height:1.7">Crea tu catálogo profesional hoy y empieza a vender de forma más inteligente.</p>
    <a href="/auth/register" class="btn-secondary" style="font-size:1rem;padding:.9rem 2.25rem">
      Crear mi catálogo gratis →
    </a>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
