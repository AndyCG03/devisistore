<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<!-- HERO -->
<section class="gradient-hero text-white py-24 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <span class="inline-block bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full mb-6 tracking-wide">
      🚀 Tu catálogo online en minutos
    </span>
    <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
      Muestra tus productos<br/>
      <span class="text-yellow-300">al mundo entero</span>
    </h1>
    <p class="text-lg md:text-xl text-blue-100 mb-10 max-w-2xl mx-auto">
      Crea tu catálogo digital gratuito, comparte el enlace con tus clientes
      y gestiona tus productos desde un panel intuitivo.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/auth/register"
         class="bg-yellow-400 hover:bg-yellow-300 text-gray-900 font-bold px-8 py-4 rounded-xl text-lg transition shadow-lg">
        Comenzar ahora →
      </a>
      <a href="#features"
         class="bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-xl text-lg transition border border-white/30">
        Ver cómo funciona
      </a>
    </div>
  </div>
</section>

<!-- CÓMO FUNCIONA -->
<section id="features" class="py-20 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Tan fácil como 1, 2, 3
      </h2>
      <p class="text-gray-500 text-lg">Sin complicaciones. Sin código. Sin diseñadores.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <% const steps = [
        { icon: '🔑', num: '01', title: 'Obtén tu acceso', desc: 'Solicita una clave de acceso al administrador y regístrate en segundos.' },
        { icon: '🏪', num: '02', title: 'Crea tu negocio', desc: 'Agrega el logo, descripción, contacto y redes sociales de tu negocio.' },
        { icon: '📦', num: '03', title: 'Sube tus productos', desc: 'Carga fotos, precios y categorías. Tu catálogo queda publicado de inmediato.' },
      ]; %>
      <% steps.forEach(s => { %>
      <div class="relative bg-gray-50 rounded-2xl p-8 border border-gray-100 card-hover">
        <div class="absolute -top-4 -left-2 text-5xl opacity-20 font-black text-brand-600"><%= s.num %></div>
        <div class="text-4xl mb-4"><%= s.icon %></div>
        <h3 class="text-xl font-bold mb-2 text-gray-900"><%= s.title %></h3>
        <p class="text-gray-500 leading-relaxed"><%= s.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- BENEFICIOS -->
<section class="py-20 px-4 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Todo lo que necesitas</h2>
      <p class="text-gray-500 text-lg">Funcionalidades pensadas para pequeños negocios.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% const features = [
        { icon: '🌐', title: 'URL pública única',     desc: 'Cada negocio tiene su propio enlace para compartir.' },
        { icon: '📱', title: 'Botón de WhatsApp',     desc: 'Tus clientes te contactan con un solo clic.' },
        { icon: '🔍', title: 'Búsqueda y filtros',    desc: 'Tus clientes encuentran lo que buscan al instante.' },
        { icon: '🖼️', title: 'Imágenes de productos', desc: 'Sube fotos de tus productos fácilmente.' },
        { icon: '📊', title: 'Panel de control',      desc: 'Gestiona todo desde un dashboard intuitivo.' },
        { icon: '🔒', title: 'Acceso controlado',     desc: 'Solo usuarios invitados pueden registrarse.' },
      ]; %>
      <% features.forEach(f => { %>
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm card-hover">
        <div class="text-3xl mb-3"><%= f.icon %></div>
        <h4 class="font-bold text-gray-900 mb-1"><%= f.title %></h4>
        <p class="text-gray-500 text-sm"><%= f.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- CTA FINAL -->
<section class="py-20 px-4 bg-brand-700 text-white text-center">
  <div class="max-w-2xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-4">
      ¿Listo para tener tu catálogo online?
    </h2>
    <p class="text-blue-200 text-lg mb-8">
      Únete y empieza a vender de forma más profesional hoy mismo.
    </p>
    <a href="/auth/register"
       class="inline-block bg-yellow-400 hover:bg-yellow-300 text-gray-900 font-bold px-10 py-4 rounded-xl text-lg transition shadow-lg">
      Crear mi catálogo gratis →
    </a>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
