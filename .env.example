# Application
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=cambia_esto_por_una_clave_segura_muy_larga

# Database (SQLite por defecto)
DB_PATH=./cataloghub.db

# Admin inicial (se crea automáticamente en el primer arranque)
ADMIN_EMAIL=admin@cataloghub.com
ADMIN_PASSWORD=Admin1234!

# Subida de imágenes
UPLOAD_MAX_SIZE_MB=5

# Rate limiting (intentos de login)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
